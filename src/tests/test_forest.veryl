module TestForest (
    clk: input clock,
    rst: input reset,

    enable: input logic,

    first_node_addr: input logic<32>,
    num_trees      : input logic<16>,

    first_feature_addr: input logic<32>,
    num_features      : input logic<4> ,

    busy : output bool,
    ready: output bool,

    prediction: output logic<32>,
    num_votes : output logic<32>,
) {

    inst ram_bus: memutils::Wishbone #( ADDR_WIDTH: 32, DATA_WIDTH: 32 );

    // Wishbone spec mandates an active high reset
    let mem_rst: reset_async_high = rst as reset_async_high;
    inst ram: memutils::WishboneRam #(
        ADDR_WIDTH: 32  ,
        DATA_WIDTH: 32  ,
        SIZE      : 4096,
    ) (
        clk          ,
        rst : mem_rst,
        port: ram_bus,
    );

    inst forest: Forest (
        clk  ,
        rst  ,

        enable  ,

        first_node_addr  ,
        num_trees        ,

        first_feature_addr  ,
        num_features        ,

        ready       ,
        busy        ,
        prediction  ,
        num_votes   ,

        ram_port: ram_bus,
    );
}

#[test(test_forest, TestForest)]
include (cocotb, "../../tb/forest_predictor.py");
