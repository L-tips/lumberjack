module TestForest (
    clk: input clock,
    rst: input reset,

    enable: input logic,

    forest_start_addr: input test_layout::RamAddr,
    num_trees        : input test_layout::TreeIdx,

    features_start_addr: input test_layout::RamAddr   ,
    num_features       : input test_layout::FeatureIdx,

    busy : output lbool,
    ready: output lbool,

    prediction: output test_layout::Prediction,
    num_votes : output test_layout::NumVotes  ,
) {
    const RAM_SIZE: u64 = 4096;

    inst ram_bus: memutils::Wishbone #(
        ADDR_WIDTH: test_layout::RAM_ADDR_WIDTH,
        DATA_WIDTH: test_layout::RAM_DATA_WIDTH,
    );

    // Wishbone spec mandates an active high reset
    // TODO: we're manually converting between rst polarity
    // because veryl's reset type casting is broken
    let mem_rst: reset_async_high = !rst as reset_async_high;

    inst ram: memutils::WishboneRam #(
        ADDR_WIDTH: test_layout::RAM_ADDR_WIDTH,
        DATA_WIDTH: test_layout::RAM_DATA_WIDTH,
        SIZE      : RAM_SIZE                   ,
    ) (
        clk         ,
        rst: mem_rst,
        wb : ram_bus,
    );

    inst forest: Forest::<test_layout> (
        clk                         ,
        rst                         ,
        enable                      ,
        forest_start_addr           ,
        num_trees                   ,
        features_start_addr         ,
        num_features                ,
        ready                       ,
        busy                        ,
        prediction                  ,
        num_votes                   ,
        dma_port           : ram_bus,
        done               : _      ,
    );
}

#[test(test_forest, TestForest)]
include (cocotb, "../../tb/test_forest.py");
