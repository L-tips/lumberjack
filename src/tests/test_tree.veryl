module TestTree (
    clk              : input clock    ,
    rst              : input reset    ,
    start            : input bool     ,
    forest_start_addr: input logic<32>,
    first_node_addr  : input logic<32>,
) {
    inst feature_bus: memutils::ScratchpadRamPort #( ADDR_WIDTH: 4, DATA_WIDTH: 32 );
    inst ram_bus    : memutils::Wishbone #( ADDR_WIDTH: 32, DATA_WIDTH: 32 );

    let mem_rst: reset_async_high = rst as reset_async_high;
    inst ram: memutils::WishboneRam #(
        ADDR_WIDTH: 32  ,
        DATA_WIDTH: 32  ,
        SIZE      : 4096,
    ) (
        clk         ,
        rst: mem_rst,
        wb : ram_bus,
    );

    var busy      : logic    ;
    var prediction: logic<32>;
    var ready     : logic    ;

    inst tree: TreePredictor (
        clk  ,
        rst  ,

        forest_start_addr  ,
        first_node_addr    ,

        start  ,

        ready       ,
        busy        ,
        prediction  ,

        feature_port: feature_bus,
        dma_port    : ram_bus    ,

        dbg_fetch_counter: _,
        dbg_state        : _,
    );
}

#[test(test_tree, TestTree)]
include (cocotb, "../../tb/test_tree.py");
