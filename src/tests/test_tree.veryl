module TestTree (
    clk              : input clock               ,
    rst              : input reset               ,
    start            : input bool                ,
    forest_start_addr: input test_layout::RamAddr,
    first_node_addr  : input test_layout::RamAddr,
) {
    const RAM_SIZE: u64 = 4096;

    inst feature_bus: memutils::ScratchpadRamPort #( ADDR_WIDTH: test_layout::FEAT_IDX_WIDTH, DATA_WIDTH: test_layout::FEATURE_WIDTH );
    inst ram_bus    : memutils::Wishbone #( ADDR_WIDTH: test_layout::RAM_ADDR_WIDTH, DATA_WIDTH: test_layout::RAM_DATA_WIDTH );

    let mem_rst: reset_async_high = rst as reset_async_high;
    inst ram: memutils::WishboneRam #(
        ADDR_WIDTH: test_layout::RAM_ADDR_WIDTH,
        DATA_WIDTH: test_layout::RAM_DATA_WIDTH,
        SIZE      : RAM_SIZE                   ,
    ) (
        clk         ,
        rst: mem_rst,
        wb : ram_bus,
    );

    var busy      : logic                  ;
    var prediction: test_layout::Prediction;
    var ready     : logic                  ;
    var error     : logic                  ;

    inst tree: TreePredictor::<test_layout> (
        clk  ,
        rst  ,

        forest_start_addr  ,
        first_node_addr    ,

        start  ,

        ready       ,
        busy        ,
        error       ,
        prediction  ,

        feature_port: feature_bus,
        dma_port    : ram_bus    ,
    );
}

#[test(test_tree, TestTree)]
include (cocotb, "../../tb/test_tree.py");
