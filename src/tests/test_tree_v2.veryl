module TestTreeV2 #(
    const TREE_CACHE_SIZE      : u32 = 1024                   ,
    const TREE_CACHE_ADDR_WIDTH: u32 = $clog2(TREE_CACHE_SIZE),
) (
    clk           : input clock                       ,
    rst           : input reset                       ,
    start         : input lbool                       ,
    first_node_idx: input logic<TREE_CACHE_ADDR_WIDTH>,
) {
    const USE_SUPERSCALAR: bbool = false;
    const FEATURE_PORTS  : u32   = if USE_SUPERSCALAR ? 2 : 1;

    inst feature_buses: memutils::ScratchpadRamPort [FEATURE_PORTS] #(
        ADDR_WIDTH: test_layout::FEAT_IDX_WIDTH,
        DATA_WIDTH: test_layout::FEATURE_WIDTH ,
    );

    inst ram_port: memutils::BramPort #( NUM_COL: 8, COL_WIDTH: 8, ADDR_WIDTH: TREE_CACHE_ADDR_WIDTH );

    var busy      : lbool                  ;
    var prediction: test_layout::Prediction;
    var ready     : lbool                  ;
    var error     : lbool                  ;

    inst tree: TreeV2::<test_layout> #(
        USE_SUPERSCALAR  ,
    ) (
        clk                          ,
        rst                          ,
        rst_cache     : rst          ,
        first_node_idx               ,
        start                        ,
        ready                        ,
        busy                         ,
        error                        ,
        prediction                   ,
        feature_ports : feature_buses,
        ram_port                     ,
    );
}

#[test(test_tree_v2, TestTreeV2)]
include (cocotb, "../../tb/test_tree_v2.py");
