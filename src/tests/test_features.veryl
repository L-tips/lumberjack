module TestFeatures (
    clk: input clock,
    rst: input reset,

    write_enable : input bool     ,
    write_data   : input logic<32>,
    write_address: input logic<4> ,
) {

    inst feature_port: FeatureBus #( MAX_FEATURES: 16 );

    inst feature_registers: Regfile #(
        NUM_PORTS       : 1 ,
        FEATURE_WIDTH   : 32,
        MAX_NUM_FEATURES: 16,
    ) (
        clk                        ,
        rst                        ,
        write_enable               ,
        write_data                 ,
        write_address              ,
        read_port    : feature_port,
    );
}

#[test(test_features, TestFeatures)]
include (cocotb, "../../tb/feature_regfile.py");
