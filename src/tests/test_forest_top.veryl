module TestForestTop (
    clk: input clock,
    rst: input reset,

    interrupt_line: output logic    ,
    dbg_mark      : input  logic<16>,
) {
    const RAM_SIZE: u64 = 4096;

    inst ram_bus    : memutils::Wishbone #( ADDR_WIDTH: test_layout::RAM_ADDR_WIDTH, DATA_WIDTH: test_layout::RAM_DATA_WIDTH );
    inst ram_arbiter: memutils::Wishbone #( ADDR_WIDTH: test_layout::RAM_ADDR_WIDTH, DATA_WIDTH: test_layout::RAM_DATA_WIDTH );
    inst control_bus: memutils::Wishbone #( ADDR_WIDTH: 32, DATA_WIDTH: 32 );

    // For testing purposes, the RAM starts at address 1005c.
    // This way we can check that the accelerator behaves correctly when the forest/features
    // are placed at "random", but aligned, addresses.
    inst ram_shifted: memutils::Wishbone #( ADDR_WIDTH: test_layout::RAM_ADDR_WIDTH, DATA_WIDTH: test_layout::RAM_DATA_WIDTH );
    always_comb {
        ram_shifted.master <> ram_arbiter.slave;
        ram_shifted.addr   =  ram_arbiter.addr - {1'b0 repeat (test_layout::RAM_ADDR_WIDTH - 17), 'h1005c};
    }

    inst arbiter: SelfArbiter #(
        RAM_ADDR_WIDTH: test_layout::RAM_ADDR_WIDTH,
        RAM_DATA_WIDTH: test_layout::RAM_DATA_WIDTH,
        CSR_ADDR_WIDTH: 32                         ,
        CSR_DATA_WIDTH: 32                         ,
    ) (
        csr_in_cyc: control_bus.cyc,
        ram_in : ram_bus    ,
        ram_out: ram_arbiter,
    );

    inst forest: ForestTop::<test_layout> (
        clk                         ,
        rst                         ,
        control_port: control_bus   ,
        dma_port    : ram_bus       ,
        interrupt   : interrupt_line,
    );

    // Wishbone spec mandates an active high reset
    // TODO: we're manually converting between rst polarity
    // because veryl's reset type casting is broken
    let mem_rst: reset_async_high = !rst as reset_async_high;
    inst ram: memutils::WishboneRam #(
        ADDR_WIDTH: test_layout::RAM_ADDR_WIDTH,
        DATA_WIDTH: test_layout::RAM_DATA_WIDTH,
        SIZE      : RAM_SIZE                   ,
    ) (
        clk             ,
        rst: mem_rst    ,
        wb : ram_shifted,
    );
}

#[test(test_forest_top, TestForestTop)]
include (cocotb, "../../tb/forest_top.py");
