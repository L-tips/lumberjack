module TestForestTop (
    clk: input clock,
    rst: input reset,

    interrupt_line: output logic,
) {

    inst ram_bus    : memutils::Wishbone #( ADDR_WIDTH: 32, DATA_WIDTH: 32 );
    inst ram_out    : memutils::Wishbone #( ADDR_WIDTH: 32, DATA_WIDTH: 32 );
    inst control_bus: memutils::Wishbone #( ADDR_WIDTH: 32, DATA_WIDTH: 32 );

    // Translate addresses to test that we calculate the correct addrs
    // Ie, the first node of the forest lives at address 0x10064 in the eyes
    // of the forest accelerator.
    inst ram_shifted: memutils::Wishbone #( ADDR_WIDTH: 32, DATA_WIDTH: 32 );
    always_comb {
        ram_shifted.master <> ram_out.slave;
        ram_shifted.addr = ram_out.addr - {15'h0, 'h10064};
    }

    inst arbiter: SelfArbiter #(
        RAM_ADDR_WIDTH: 32,
        RAM_DATA_WIDTH: 32,
        CSR_ADDR_WIDTH: 32,
        CSR_DATA_WIDTH: 32,
    ) (
        csr_in : control_bus,
        ram_in : ram_bus    ,
        ram_out             ,
    );

    inst forest: ForestTop #(
        FEATURE_SIZE  : 4 ,
        RAM_ADDR_WIDTH: 32,
        RAM_DATA_WIDTH: 32,
    ) (
        clk                         ,
        rst                         ,
        control_port: control_bus   ,
        ram_port    : ram_bus       ,
        interrupt   : interrupt_line,
    );

    // Wishbone spec mandates an active high reset
    let mem_rst: reset_async_high = rst as reset_async_high;
    inst ram: memutils::WishboneRam #(
        ADDR_WIDTH: 32  ,
        DATA_WIDTH: 32  ,
        SIZE      : 4096,
    ) (
        clk         ,
        rst: mem_rst,
        wb : ram_shifted,
    );
}

#[test(test_forest_top, TestForestTop)]
include (cocotb, "../../tb/forest_top.py");
