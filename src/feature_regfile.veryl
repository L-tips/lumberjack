module Regfile #(
    param NUM_PORTS       : u8  = 2  ,
    param FEATURE_WIDTH   : u8  = 32 ,
    param MAX_NUM_FEATURES: u16 = 256,
) (
    clk: input clock,
    rst: input reset,

    // Writes
    write_enable : input bool                ,
    write_data   : input logic<FEATURE_WIDTH>,
    write_address: input logic<ADDR_WIDTH>   ,

    // Read ports
    // read_ports: modport FeatureBus::slave [NUM_PORTS],
    read_port: modport FeatureBus::slave,
) {
    const ADDR_WIDTH: u32 = $clog2(MAX_NUM_FEATURES);

    var registers: logic<FEATURE_WIDTH> [MAX_NUM_FEATURES];

    // Async read logic
    always_comb {
        read_port.feature = registers[read_port.address];
        // for i: u16 in 0..MAX_NUM_FEATURES {
        //     read_ports[i].feature = registers[read_ports[i].address];
        // }
    }

    // Write logic
    always_ff {
        if_reset {
            for i: u16 in 0..MAX_NUM_FEATURES {
                /* verilator lint_off WIDTHTRUNC */
                registers[i] = 0;
                /* verilator lint_on WIDTHTRUNC */
            }
        } else {
            if write_enable {
                registers[write_address] = write_data;
            }
        }
    }
}
