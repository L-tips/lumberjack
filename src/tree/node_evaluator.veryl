module NodeEvaluator::<L: Layout> #(
    param TREE_CACHE_ADDR_WIDTH: u32 = 0,
) (
    node            : input   standard_layout::Node                                          ,
    current_node_ptr: input   logic                                   <TREE_CACHE_ADDR_WIDTH>,
    feature_port    : modport memutils::ScratchpadRamPort::read_master                       ,

    is_prediction: output lbool                               ,
    prediction   : output L::Prediction                       ,
    next_node_ptr: output logic        <TREE_CACHE_ADDR_WIDTH>,
    error        : output lbool                               ,
) {

    var branch_left: lbool;

    // Compare the feature to the split, which
    // are formatted as IEEE754 bfloat16
    inst branch_picker: FloatLeq ( a: feature_port.data, b: node.split, leq: branch_left );

    assign feature_port.address = node.flags.split_idx[L::FEAT_IDX_WIDTH - 1:0];

    // Check that out tree is a DAG and that there are no
    // circular conditions
    assign error = !is_prediction && next_node_ptr <= current_node_ptr;
    // assign error = false;

    var next_ptr: logic<L::CLASS_PTR_WIDTH>;
    assign next_node_ptr = next_ptr[TREE_CACHE_ADDR_WIDTH - 1:0];

    always_comb {
        // Evaluate the node and decide next action
        if branch_left {
            prediction    = node.left[L::CLASS_IDX_WIDTH - 1:0];
            next_ptr      = node.left;
            is_prediction = node.flags.left_predict;
        } else {
            prediction    = node.right[L::CLASS_IDX_WIDTH - 1:0];
            next_ptr      = node.right;
            is_prediction = node.flags.right_predict;
        }
    }
}
