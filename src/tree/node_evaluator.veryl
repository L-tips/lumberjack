module NodeEvaluator::<L: Layout> #(
    param CELL_CACHE_ADDR_WIDTH: u32 = 16,
) (
    node            : input   node_layout::Node                                          ,
    current_node_idx: input   logic                                   <CELL_CACHE_ADDR_WIDTH>,
    feature_port    : modport memutils::ScratchpadRamPort::read_master                       ,

    is_prediction: output lbool                               ,
    prediction   : output L::Prediction                       ,
    next_node_idx: output logic        <CELL_CACHE_ADDR_WIDTH>,
    error        : output lbool                               ,
) {

    var branch_left: lbool;

    // Compare the feature to the split, which
    // are formatted as IEEE754 bfloat16
    inst branch_picker: FloatLeq ( a: feature_port.data, b: node.split, leq: branch_left );

    assign feature_port.address = node.flags.split_idx as L::FeatureIdx;

    // Check that out tree is a DAG and that there are no
    // circular conditions
    assign error = !is_prediction && next_node_idx <= current_node_idx;
    // assign error = false;

    var next_ptr: node_layout::ClassPtr;
    assign next_node_idx = next_ptr[CELL_CACHE_ADDR_WIDTH - 1:0];

    always_comb {
        // Evaluate the node and decide next action
        if branch_left {
            prediction    = node.left as L::Prediction;
            next_ptr      = node.left;
            is_prediction = node.flags.left_predict;
        } else {
            prediction    = node.right as L::Prediction;
            next_ptr      = node.right;
            is_prediction = node.flags.right_predict;
        }
    }
}
