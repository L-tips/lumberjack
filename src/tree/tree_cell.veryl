module TreeCell::<L: Layout> #(
    /// Use superscalar architecture
    param USE_SUPERSCALAR: bbool = true,

    /// Size of the tree cache in 64 bit dwords
    param CELL_CACHE_SIZE: u64 = 1024,

    const CELL_CACHE_ADDR_WIDTH: u32 = $clog2(CELL_CACHE_SIZE)   ,
    const FEAT_PORTS_PER_TREE  : u32 = if USE_SUPERSCALAR ? 2 : 1,
) (
    clk: input clock,
    rst: input reset,

    rst_cache: input reset,

    /// Synchronous input, active high strobe. Signals the start of a full tree traversal evaluation.
    /// The cell will launch a read at the next header address asynchronously on `start` going high.
    /// A new `start` strobe may be asserted on the same cycle as `pred_ack`, but no earlier.
    start: input lbool,

    /// Synchronous input, active high strobe. May only be asserted on the same cycles as `start`.
    /// A tree cell retains its traversal state and remembers which header address to fetch next.
    /// When `restart` is asserted, the next tree header will be fetched in cache at address 0
    /// (ie, restarting a brand new forest evaluation.)
    restart: input lbool,

    /// Synchronous output, active high. When `pred_valid` is asserted, a new prediction
    /// is ready to be read. This signal may be asserted as early as the cycle following a
    /// `start` strobe. Every `start` will eventually be paired with a `pred_valid`.
    /// `pred_valid` and `prediction` will be held stable until `pred_ack` is asserted.
    /// Exception: if num_trees_in_cell == 0 after a start && restart strobe, no prediction
    /// will be output.
    pred_valid: output lbool,

    /// Synchronous output. The evaluated tree's predicted class
    prediction: output L::Prediction,

    /// Asynchronous input, active high. May be asserted any cycle
    /// where a prediction may be accepted.
    /// A prediction is considered registered when `pred_valid && pred_ack`.
    pred_ack: input lbool,

    /// Synchronous output. The number of trees in this cell's cache. This output is guaranteed to
    /// be valid the cycle following a `start && restart` assertion.
    num_trees_in_cell: output node_layout::NumTrees,

    /// Signals the `num_trees_in_cell` output is valid. Typically, it is guaranteed to be valid exactly
    /// two cycles after a `start && restart` strobe.
    num_trees_in_cell_valid: output lbool,

    /// Asynchronous output. The cell is currently evaluating a tree. This also entails that
    /// the cell's cache is occupied.
    busy: output lbool,

    feature_ports: modport memutils::ScratchpadRamPort::read_master [FEAT_PORTS_PER_TREE],
    ram_port     : modport memutils::BramPort::slave                                     ,
) {
    const BITS_PER_COL    : u8  = 8;
    const CACHE_NUM_COL   : u8  = if USE_SUPERSCALAR ? node_layout::NODE_SIZE * 2 : node_layout::NODE_SIZE;
    const CACHE_DATA_WIDTH: u32 = CACHE_NUM_COL * BITS_PER_COL;
    const NODE_BITS       : u32 = node_layout::NODE_SIZE * BITS_PER_COL;

    type NodePtr = logic<CELL_CACHE_ADDR_WIDTH>;

    enum State {
        idle = 0,
        read_header = 1,
        evaluating = 2,
        hold_result = 3,
        prefetch_header = 4,
    }

    var state     : State;
    var next_state: State;

    var header_addr        : NodePtr;
    var current_header_addr: NodePtr;

    var current_tree_len  : node_layout::TreeLen;
    var current_tree_len_q: node_layout::TreeLen;

    let master_select: lbool = !busy;

    var start_q  : lbool;
    var restart_q: lbool;

    inst tree_cache_bus: memutils::BramPort #(
        NUM_COL   : CACHE_NUM_COL        ,
        COL_WIDTH : BITS_PER_COL         ,
        ADDR_WIDTH: CELL_CACHE_ADDR_WIDTH,
    );
    inst tree_cache_bus_demuxed: memutils::BramPort #(
        NUM_COL   : CACHE_NUM_COL        ,
        COL_WIDTH : BITS_PER_COL         ,
        ADDR_WIDTH: CELL_CACHE_ADDR_WIDTH,
    );

    inst cache_demux: BramDemux #(
        ADDR_WIDTH: CELL_CACHE_ADDR_WIDTH,
        DATA_WIDTH: CACHE_DATA_WIDTH     ,
    ) (
        master_0     : tree_cache_bus        ,
        master_1     : ram_port              ,
        slave        : tree_cache_bus_demuxed,
        master_select                        ,
    );

    // RAM with 64b wide data so we can fetch a node in a single cycle
    inst tree_cache: memutils::SinglePortBlockRam #(
        NUM_COL  : CACHE_NUM_COL  ,
        COL_WIDTH: BITS_PER_COL   ,
        RAM_DEPTH: CELL_CACHE_SIZE,
    ) (
        clk                         ,
        rst : rst_cache             ,
        port: tree_cache_bus_demuxed,
    );

    var read_addr     : NodePtr;
    var next_read_addr: NodePtr;

    let current_node_idx: NodePtr = read_addr - current_header_addr;

    // Node indices are relative, mapping directly to a dword index
    // in the RAM.
    assign tree_cache_bus.address = if USE_SUPERSCALAR ? next_read_addr >> 1 : next_read_addr;

    // Pick the low bits from the read data
    let node_low: node_layout::Node = tree_cache_bus.read_data as node_layout::Node;

    var eval_is_prediction_0: lbool        ;
    var eval_prediction_0   : L::Prediction;
    var eval_next_idx_0     : NodePtr      ;

    inst evaluator_0: NodeEvaluator::<L> #(
        CELL_CACHE_ADDR_WIDTH  ,
    ) (
        node            : node_low            ,
        current_node_idx: current_node_idx    ,
        is_prediction   : eval_is_prediction_0,
        prediction      : eval_prediction_0   ,
        next_node_idx   : eval_next_idx_0     ,
        feature_port    : feature_ports[0]    ,
    );

    var eval_is_prediction: lbool        ;
    var eval_prediction   : L::Prediction;
    var eval_next_idx     : NodePtr      ;

    var header_data: node_layout::TreeHeader;

    let discard_prefetch: lbool   = state == State::prefetch_header && !start_q;
    let prefetch_miss   : lbool   = state == State::prefetch_header && restart_q && start_q;
    let next_header_addr: NodePtr = current_header_addr + current_tree_len as NodePtr;


    // When fetching the header, if the first node is at index 1, we already have the result available
    // in the high data bits. Only relevant when using superscalar evaluation.
    var header_points_to_node_high: lbool;

    #[allow(unused_variable)]
    var dbg_superscalar_hit: lbool;

    #[allow(unused_variable)]
    var dbg_superscalar_miss: lbool;

    #[allow(unused_variable)]
    let dbg_mem_fetch: lbool = state == State::read_header || state == State::prefetch_header || state
        == State::evaluating;

    if USE_SUPERSCALAR :evaluator_1 {
        // Pick the high bits from the read data
        let node_high: node_layout::Node = tree_cache_bus.read_data[NODE_BITS * 2 - 1:NODE_BITS] as node_layout::Node;

        let eval_high_bits: lbool   = read_addr[0];
        let node_idx      : NodePtr = if eval_high_bits ? current_node_idx : current_node_idx + 1;

        var eval_is_prediction_1: lbool        ;
        var eval_prediction_1   : L::Prediction;
        var eval_next_idx_1     : NodePtr      ;

        inst evaluator_1: NodeEvaluator::<L> #(
            CELL_CACHE_ADDR_WIDTH  ,
        ) (
            node            : node_high           ,
            current_node_idx: node_idx            ,
            is_prediction   : eval_is_prediction_1,
            prediction      : eval_prediction_1   ,
            next_node_idx   : eval_next_idx_1     ,
            feature_port    : feature_ports[1]    ,
        );

        // This only works if read_addr is the addr of the low-bits node. Although if
        // read_addr[0] == 1, then we're already picking the high-bits node anyway,
        // so we don't care about this result.
        let node_low_points_to_node_high: lbool = !eval_is_prediction_0 && eval_next_idx_0 == current_node_idx + 1;
        let pick_node_high              : lbool = eval_high_bits || node_low_points_to_node_high
            || header_points_to_node_high;

        always_comb {
            if pick_node_high {
                eval_is_prediction = eval_is_prediction_1;
                eval_prediction    = eval_prediction_1;
                eval_next_idx      = eval_next_idx_1;
            } else {
                eval_is_prediction = eval_is_prediction_0;
                eval_prediction    = eval_prediction_0;
                eval_next_idx      = eval_next_idx_0;
            }

        }

        assign header_data = if eval_high_bits ?
            node_high as node_layout::TreeHeader
        :
            node_low as node_layout::TreeHeader
        ;

        assign header_points_to_node_high = (state == State::read_header || state == State::prefetch_header)
            && header_data.first_node_ptr == 1 && !eval_high_bits;

        always_comb {
            dbg_superscalar_hit  = false;
            dbg_superscalar_miss = false;

            if dbg_mem_fetch && !(prefetch_miss || discard_prefetch) {
                dbg_superscalar_hit  = header_points_to_node_high || node_low_points_to_node_high;
                dbg_superscalar_miss = !header_points_to_node_high && !node_low_points_to_node_high;
            }
        }

    } else {
        assign eval_is_prediction         = eval_is_prediction_0;
        assign eval_prediction            = eval_prediction_0;
        assign eval_next_idx              = eval_next_idx_0;
        assign header_data                = node_low as node_layout::TreeHeader;
        assign header_points_to_node_high = false;
        assign dbg_superscalar_hit        = false;
        assign dbg_superscalar_miss       = false;
    }

    always_comb {
        // Default: maintain current state
        next_state        = state;
        next_read_addr    = read_addr;
        header_addr       = current_header_addr;
        current_tree_len  = current_tree_len_q;
        num_trees_in_cell = 0;

        pred_valid = state != State::idle && eval_is_prediction;

        tree_cache_bus.enable            = false;
        tree_cache_bus.byte_write_enable = 0;
        tree_cache_bus.write_data        = 0;


        // State machine
        case state {
            State::read_header, State::prefetch_header: {

                if discard_prefetch {
                    // Don't start a new evaluation. Fetched line discarded
                    tree_cache_bus.enable = false;
                    next_state            = State::idle;
                    pred_valid            = false;
                } else if prefetch_miss {
                    // Prefetch miss. Fetch the header at address 0 and restart evaluation from there
                    next_state            = State::read_header;
                    next_read_addr        = 0;
                    header_addr           = 0;
                    tree_cache_bus.enable = true;
                    pred_valid            = false;
                } else {
                    // Fetch hit. Directly evaluate prefetched cache line
                    next_read_addr    += header_data.first_node_ptr as NodePtr;
                    current_tree_len  =  header_data.tree_len;
                    num_trees_in_cell =  header_data.trees_in_cell;

                    // If the header points to node index 1, the node data is already available.
                    // We can directly evaluate it.
                    if header_points_to_node_high && eval_is_prediction {
                        next_state = State::hold_result;
                    } else if num_trees_in_cell == 0 && num_trees_in_cell_valid {
                        // If cell is empty, go back to idle without committing anything
                        tree_cache_bus.enable = false;
                        next_state            = State::idle;
                    } else {
                        tree_cache_bus.enable = true;
                        next_state            = State::evaluating;
                    }
                }
            }

            State::evaluating: {
                // Leaf node reached - use prediction
                if eval_is_prediction {
                    next_state = State::hold_result;
                } else {
                    // Continue on with another read
                    tree_cache_bus.enable = true;
                    next_read_addr        = eval_next_idx as NodePtr + current_header_addr;
                }
            }

            State::idle: {
                // As per the interface definition, a start may not occur
                // earlier than an ack for the previous start.
                if start_q {
                    // At this state, the current header is known (has been set during the ack cycle).
                    // Exception is if restart_q is set, then we need to fetch at addr 0.
                    next_state            = State::read_header;
                    tree_cache_bus.enable = true;

                    if restart_q {
                        next_read_addr = 0;
                        header_addr    = 0;
                    }

                }
            }
            State::hold_result: {}

            // NOTE: Default should be unreachable: explicitly handle other states if adding
            // more states to the State enum
            default: {}
        }

        if pred_ack && pred_valid {
            tree_cache_bus.enable = true;
            next_read_addr        = next_header_addr;
            header_addr           = next_header_addr;
            next_state            = State::prefetch_header;
        }
        // pred_ack low: hold. No state change, outputs stand.

    }

    always_ff (clk, rst) {
        if_reset {
            start_q                 = false;
            restart_q               = false;
            num_trees_in_cell_valid = false;

            read_addr           = 0;
            current_header_addr = 0;
            current_tree_len_q  = 0;
            state               = State::idle;
        } else {
            start_q                 = start;
            restart_q               = restart;
            num_trees_in_cell_valid = restart_q && start_q;

            read_addr           = next_read_addr;
            current_header_addr = header_addr;
            current_tree_len_q  = current_tree_len;
            state               = next_state;
        }
    }

    assign busy       = start_q || state != State::idle;
    assign prediction = eval_prediction;
}
