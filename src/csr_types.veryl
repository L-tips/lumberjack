package csr_types::<L: Layout> {
    const DATA_WIDTH: u32               = 32;
    type Data       = logic<DATA_WIDTH>;

    const SELECT_WIDTH: u32                 = DATA_WIDTH / 8;
    type Select       = logic<SELECT_WIDTH>;

    // Up to 16 registers, plus however many features
    const NUM_REGISTERS: u32               = 16 + L::MAX_NUM_FEATURES * node_layout::FEATURE_WIDTH / DATA_WIDTH;
    const ADDR_WIDTH   : u32               = $clog2(NUM_REGISTERS);
    type Address       = logic<ADDR_WIDTH>;
}
