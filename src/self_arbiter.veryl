/// A simple arbiter, to be used in
/// systems where the forest accelerator is connected
// to the same bus twice, both the control
/// bus as a slave, and the DMA port as a master, with.
/// not arbiter in between them.
///
/// Priority will always be given to the control bus.
module SelfArbiter #(
    param RAM_DATA_WIDTH: u8 = 32,
    param RAM_ADDR_WIDTH: u8 = 32,
    param CSR_DATA_WIDTH: u8 = 32,
    param CSR_ADDR_WIDTH: u8 = 32,
) (
    csr_in : modport memutils::Wishbone::slave ,
    ram_out: modport memutils::Wishbone::master,
    ram_in : modport memutils::Wishbone::slave ,
) {
    always_comb {
        ram_in       <> ram_out;
        ram_in.stall =  ram_out.stall || csr_in.cyc;
    }

}
