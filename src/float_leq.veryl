/// Perform the lesser-or-equal operation on
/// two bfloat16 IEEE754 formatted floats.
///
/// Outputs: true if a <= b, false otherwise.
module FloatLeq (
    a: input logic<16>,
    b: input logic<16>,

    leq: output lbool,
) {
    // NaN detection
    let a_nan: lbool = a[msb - 1:msb - 8] == 8'hff && a[6:0] != 0;
    let b_nan: lbool = b[msb - 1:msb - 8] == 8'hff && b[6:0] != 0;

    // Zero detection
    let a_zero: lbool = a[msb - 1:0] == 15'h0;
    let b_zero: lbool = b[msb - 1:0] == 15'h0;

    // Extract sign bits
    let a_neg: lbool = a[msb];
    let b_neg: lbool = b[msb];

    var leq_raw: lbool;
    always_comb {
        if a_neg != b_neg {
            // If signs differ, negative is less
            leq_raw = a_neg;
        } else if a_neg {
            // If both are negative, reverse the comparison
            leq_raw = b <= a;
        } else {
            // If both are positive, normal comparison
            leq_raw = a <= b;
        }
    }

    // Final comparison logic
    assign leq = (!a_nan && !b_nan) && (a_zero && b_zero || leq_raw);
}
