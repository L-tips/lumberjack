module TreePredictor (
    clk: input clock,
    rst: input reset,

    start: input bool,
    // TODO: hardcoded
    first_node_addr: input logic<32>,

    ready: output bool,
    busy : output bool,
    // TODO: hardcoded
    prediction: output logic<32>,

    feature_port: modport memutils::ScratchpadRamPort::read_master,
    ram_port    : modport memutils::Wishbone::master              ,
) {

    // TODO: hardcoded
    struct Flags {
        left_predict : logic    ,
        right_predict: logic    ,
        split_idx    : logic<30>,
    }

    // TODO: hardcoded
    struct Node {
        left : logic<32>,
        right: logic<32>,
        split: logic<32>,
        flags: Flags    ,
    }

    enum State {
        idle,
        fetching,
        evaluating,
    }

    // TODO: hardcoded
    var node_ptr: logic<32>;
    // TODO: hardcoded
    var fetched_node: logic<128>;
    var node        : Node      ;

    var state     : State;
    var next_state: State;
    // TODO: hardcoded
    var fetch_counter     : logic<3>;
    var next_fetch_counter: logic<3>;

    // Mux node ptr to handle immediate start condition
    // let effective_ptr: logic<3> = if (start && !busy_reg) ? 0 : node_ptr;

    // Break the node down into its components
    /// Node size in bytes
    // TODO: hardcoded
    const NODE_SIZE : u8 = 16;
    assign node.left  = fetched_node[0+:32];
    assign node.right = fetched_node[32+:32];
    assign node.split = fetched_node[64+:32];
    assign node.flags = fetched_node[96+:32];

    // Retrieve the feature based on the split index
    /* verilator lint_off WIDTHTRUNC */
    assign feature_port.address = node.flags.split_idx;
    /* verilator lint_on WIDTHTRUNC */

    // TODO: hardcoded
    var next_node_ptr: logic<32>;

    var ready_reg : bool;
    var next_ready: bool;

    var busy_reg : bool;
    var next_busy: bool;

    // TODO: hardcoded
    var next_prediction  : logic<32> ;
    var next_fetched_node: logic<128>;

    var debug_branch_taken : logic<2>;
    var debug_is_prediction: bool    ;

    always_comb {
        // Default: maintain current state
        next_state         = state;
        next_node_ptr      = node_ptr;
        next_ready         = ready_reg;
        next_busy          = busy_reg;
        next_prediction    = prediction;
        next_fetch_counter = fetch_counter;
        next_fetched_node  = fetched_node;

        // RAM control defaults
        ram_port.addr = node_ptr;
        ram_port.stb  = false;
        ram_port.cyc  = false;

        debug_branch_taken  = 0;
        debug_is_prediction = false;

        // State machine
        case state {
            State::idle: {
                if start {
                    next_state         = State::fetching;
                    next_node_ptr      = first_node_addr;
                    next_ready         = false;
                    next_busy          = true;
                    next_fetch_counter = 0;

                    // Start RAM read request
                    ram_port.stb  = true;
                    ram_port.cyc  = true;
                    ram_port.addr = first_node_addr;
                }
            }

            State::fetching: {
                // Continue the read transaction
                ram_port.stb = true;
                ram_port.cyc = true;

                // Wait for the bus to un-stall
                if ram_port.stall {
                    // TODO handle stalls and bus errors


                    // Store incoming data at the appropriate position in fetched_node
                } else if ram_port.ack && !ram_port.stall {
                    // Fetch next word
                    next_fetch_counter += 1;
                    ram_port.addr      =  node_ptr + next_fetch_counter * 4;

                    // Store the data returned from memory
                    // TODO: hardcoded
                    next_fetched_node[fetch_counter * 32+:32] = ram_port.read_data;

                    if fetch_counter == 3 {
                        // Release the bus for one cycle so it can
                        // potentially process other requests
                        ram_port.stb = false;
                        ram_port.cyc = false;

                        // We've fetched all 4 words (128 bits)
                        next_state         = State::evaluating;
                        next_fetch_counter = 0;
                    }
                }
            }

            State::evaluating: {
                // Evaluate the node and decide next action
                /* verilator lint_off WIDTHTRUNC */
                if feature_port.data <= node.split {

                    debug_branch_taken = 1;

                    if node.flags.left_predict {
                        // Leaf node reached - use prediction
                        next_ready      = true;
                        next_busy       = false;
                        next_prediction = node.left;
                        next_state      = State::idle;

                        debug_is_prediction = true;

                    } else {
                        // Go to left child
                        // Start RAM read request
                        ram_port.stb  = true;
                        ram_port.cyc  = true;
                        next_node_ptr = node.left * NODE_SIZE;
                        ram_port.addr = next_node_ptr;

                        next_state = State::fetching;
                    }
                } else {

                    debug_branch_taken = 2;

                    if node.flags.right_predict {
                        // Leaf node reached - use prediction
                        next_ready      = true;
                        next_busy       = false;
                        next_prediction = node.right;
                        next_state      = State::idle;

                        debug_is_prediction = true;

                    } else {
                        // Go to right child
                        // Start RAM read request
                        ram_port.stb  = true;
                        ram_port.cyc  = true;
                        next_node_ptr = node.right * NODE_SIZE;
                        ram_port.addr = next_node_ptr;

                        next_state = State::fetching;
                    }
                }
                /* verilator lint_on WIDTHTRUNC */
            }

            default: {
                // TODO: do nothing?
            }
        }
    }

    always_ff {
        if_reset {
            node_ptr      = 0;
            ready_reg     = false;
            busy_reg      = false;
            prediction    = 0;
            state         = State::idle;
            fetch_counter = 0;
            fetched_node  = 0;
        } else {
            node_ptr      = next_node_ptr;
            ready_reg     = next_ready;
            busy_reg      = next_busy;
            prediction    = next_prediction;
            state         = next_state;
            fetch_counter = next_fetch_counter;
            fetched_node  = next_fetched_node;
        }
    }

    assign busy                  = busy_reg || start;
    assign ready                 = ready_reg && !start;
    assign ram_port.write_enable = false;
    // TODO: hardcoded
    assign ram_port.select = 4'b1111;
}
