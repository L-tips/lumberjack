module TreePredictor::<L: Layout> (
    clk: input clock,
    rst: input reset,

    start            : input bool      ,
    first_node_addr  : input L::RamAddr,
    forest_start_addr: input L::RamAddr,

    ready     : output bool         ,
    busy      : output bool         ,
    error     : output bool         ,
    prediction: output L::Prediction,

    feature_port: modport memutils::ScratchpadRamPort::read_master,
    dma_port    : modport memutils::Wishbone::master              ,
) {
    enum State {
        idle,
        fetching,
        evaluating,
    }

    var node_ptr: L::RamAddr;
    // TODO: hardcoded
    var fetched_node: logic<128>;

    let node: standard_layout::Node = fetched_node as standard_layout::Node;

    var state     : State;
    var next_state: State;
    // TODO: hardcoded
    var fetch_counter     : logic<3>;
    var next_fetch_counter: logic<3>;

    // Break the node down into its components
    /// Node size in bytes

    // Retrieve the feature based on the split index
    assign feature_port.address = node.flags.split_idx[L::FEAT_IDX_WIDTH - 1:0];

    var next_node_ptr: L::RamAddr;

    var ready_reg : bool;
    var next_ready: bool;

    var busy_reg : bool;
    var next_busy: bool;

    var err_reg : bool;
    var next_err: bool;

    var next_prediction: L::Prediction;
    // TODO: hardcoded
    var next_fetched_node: logic<128>;

    var is_prediction: bool;

    var prev_wb_complete: logic     ;
    var addr            : L::RamAddr;
    var next_addr       : L::RamAddr;

    assign dma_port.addr = next_addr;

    always_ff (clk, rst) {
        if_reset {
            prev_wb_complete = 0;
            addr             = 0;
        } else {
            prev_wb_complete = dma_port.valid_request();
            addr             = next_addr;
        }
    }

    var branch_left: logic;

    // Compare the feature to the split, which
    // are formatted as IEEE754 32-bit floats
    inst pick_branch: FloatLeq (
        a  : feature_port.data,
        b  : node.split       ,
        leq: branch_left      ,
    );

    always_comb {
        // Default: maintain current state
        next_state         = state;
        next_node_ptr      = node_ptr;
        next_ready         = ready_reg;
        next_busy          = busy_reg;
        next_err           = err_reg;
        next_prediction    = prediction;
        next_fetch_counter = fetch_counter;
        next_fetched_node  = fetched_node;

        // RAM control defaults
        next_addr    = addr;
        dma_port.stb = false;
        dma_port.cyc = false;

        is_prediction = false;

        // State machine
        case state {
            State::idle: {
                if start {
                    next_state         = State::fetching;
                    next_node_ptr      = first_node_addr;
                    next_ready         = false;
                    next_busy          = true;
                    next_err           = false;
                    next_fetch_counter = 0;

                    // Start RAM read request
                    dma_port.stb = true;
                    dma_port.cyc = true;
                    next_addr    = first_node_addr;
                }
            }

            State::fetching: {
                // Continue the read transaction
                // Continue the read transaction, only if bus isn't stalled
                dma_port.stb = true;
                dma_port.cyc = true;

                // Store incoming data at the appropriate position in fetched_node
                if dma_port.ack && prev_wb_complete {
                    // Fetch next word
                    next_fetch_counter += 1;
                    next_addr          =  node_ptr + next_fetch_counter * 4;

                    // Store the data returned from memory
                    // TODO: hardcoded
                    next_fetched_node[fetch_counter * 32+:32] = dma_port.read_data;

                    if fetch_counter == 3 {
                        // Release the bus for one cycle so it can
                        // potentially process other requests
                        dma_port.stb = false;
                        dma_port.cyc = false;

                        // We've fetched all 4 words (128 bits)
                        next_state         = State::evaluating;
                        next_fetch_counter = 0;
                    }
                }
            }

            State::evaluating: {
                // Evaluate the node and decide next action
                if branch_left {
                    next_prediction = node.left[L::CLASS_IDX_WIDTH - 1:0];
                    next_node_ptr   = node.left * L::NODE_SIZE + forest_start_addr;
                    is_prediction   = node.flags.left_predict;
                } else {
                    next_prediction = node.right[L::CLASS_IDX_WIDTH - 1:0];
                    next_node_ptr   = node.right * L::NODE_SIZE + forest_start_addr;
                    is_prediction   = node.flags.right_predict;
                }

                if is_prediction {
                    // Leaf node reached - use prediction
                    next_ready = true;
                    next_busy  = false;
                    next_state = State::idle;
                } else {
                    // Check that out tree is a DAG and that there are no
                    // circular conditions
                    if next_node_ptr >: node_ptr {
                        // Go to left child
                        // Start RAM read request
                        dma_port.stb = true;
                        dma_port.cyc = true;
                        next_addr    = next_node_ptr;

                        next_state = State::fetching;
                    } else {
                        next_err   = true;
                        next_busy  = false;
                        next_state = State::idle;
                    }
                }
            }

            default: {
                // TODO: do nothing?
            }
        }
    }

    always_ff {
        if_reset {
            node_ptr      = 0;
            ready_reg     = false;
            busy_reg      = false;
            err_reg       = false;
            prediction    = 0;
            state         = State::idle;
            fetch_counter = 0;
            fetched_node  = 0;
        } else {
            node_ptr      = next_node_ptr;
            ready_reg     = next_ready;
            busy_reg      = next_busy;
            err_reg       = next_err;
            prediction    = next_prediction;
            state         = next_state;
            fetch_counter = next_fetch_counter;
            fetched_node  = next_fetched_node;
        }
    }

    assign busy                  = busy_reg || start;
    assign ready                 = ready_reg && !start;
    assign error                 = err_reg;
    assign dma_port.write_enable = false;

    // TODO: hardcoded
    assign dma_port.select     = 4'b1111;
    assign dma_port.write_data = 0;
    assign dma_port.lock       = false;
}
