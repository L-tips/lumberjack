proto package Layout {
    /// Maximum number of classes that can be predicted
    const MAX_NUM_CLASSES: u32;

    /// Max number of features addressable by a node
    const MAX_NUM_FEATURES: u32;

    /// Max number of trees in a forest
    const MAX_NUM_TREES: u32;

    const RAM_ADDR_WIDTH: u8;
    const RAM_DATA_WIDTH: u8;

    const TREE_IDX_WIDTH : u32;
    const CLASS_IDX_WIDTH: u32;
    /// Width of the IDX.FEAT field in bits.
    const FEAT_IDX_WIDTH: u32;

    type RamAddr   ;
    type FeatureIdx;
    type TreeIdx   ;
    type Prediction;
    type NumVotes  ;
}

package standard_layout for Layout {
    /// Maximum number of classes that can be predicted
    const MAX_NUM_CLASSES: u32 = 16;

    /// Max number of features addressable by a node
    const MAX_NUM_FEATURES: u32 = 16;

    /// Max number of trees in a forest
    const MAX_NUM_TREES: u32 = 512;

    const RAM_ADDR_WIDTH: u8 = 32;
    const RAM_DATA_WIDTH: u8 = 32;

    const TREE_IDX_WIDTH : u32 = $clog2(MAX_NUM_TREES);
    const CLASS_IDX_WIDTH: u32 = $clog2(MAX_NUM_CLASSES);
    /// Width of the IDX.FEAT field in bits.
    const FEAT_IDX_WIDTH: u32 = $clog2(MAX_NUM_FEATURES);

    type RamAddr    = logic<RAM_ADDR_WIDTH> ;
    type TreeIdx    = logic<TREE_IDX_WIDTH> ;
    type FeatureIdx = logic<FEAT_IDX_WIDTH> ;
    type Prediction = logic<CLASS_IDX_WIDTH>;
    type NumVotes   = logic<TREE_IDX_WIDTH> ;
}

package node_layout {
    /// Size of a single node in bytes
    const NODE_SIZE: u8 = 8;

    /// Width of a single feature in bits
    const FEATURE_WIDTH: u32 = 16;

    /// Width of the LEFT/RIGHT fields in bits,
    /// which represent either node pointers or
    /// class predictions
    const CLASS_PTR_WIDTH: u32 = FEATURE_WIDTH;

    type ClassPtr = logic<CLASS_PTR_WIDTH>;

    struct Flags {
        left_predict : logic    ,
        right_predict: logic    ,
        split_idx    : logic<14>,
    }

    // Field order inverted - little-endian memory
    struct Node {
        flags: Flags    ,
        split: logic<16>,
        right: logic<16>,
        left : logic<16>,
    }

    // Field order inverted - little-endian memory
    struct TreeHeader {
        first_node_ptr: logic<32>,
        tree_len      : logic<32>,
    }
}
