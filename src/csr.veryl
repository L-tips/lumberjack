/// CSR interface for controlling the ForestTop module.
module CsrInterface (
    clk: input clock,
    rst: input reset,

    // --- CSR interface signals ---
    address: input  logic<ADDR_WIDTH>,
    write  : input  bool             , // Write enable
    read   : input  bool             , // Read enable
    wdata  : input  logic<32>        , // Write data
    rdata  : output logic<32>        , // Read data

    // --- Output control signals ---
    enable           : output logic    ,
    num_trees        : output logic<16>,
    forest_start_addr: output logic<32>,
    num_features     : output logic<4> ,
    first_feature    : output logic<32>,
    interrupt        : output logic    ,

    // --- Input control signals ---
    ready     : input logic    ,
    busy      : input logic    ,
    done      : input logic    ,
    prediction: input logic<32>,
    num_votes : input logic<32>,

    dbg_tree_fetch_counter  : input logic<3> ,
    dbg_tree_state          : input logic<2> ,
    dbg_forest_fetch_counter: input logic<4> ,
    dbg_forest_state        : input logic<2> ,
    dbg_tree_idx            : input logic<16>,

) {
    const ADDR_WIDTH: u32 = $clog2(9);

    const CTRL             : logic<ADDR_WIDTH> = 0;
    const CTRL_SET         : logic<ADDR_WIDTH> = 1;
    const CTRL_CLR         : logic<ADDR_WIDTH> = 2;
    const NUM_TREES        : logic<ADDR_WIDTH> = 3;
    const FOREST_START_ADDR: logic<ADDR_WIDTH> = 4;
    const NUM_FEATURES     : logic<ADDR_WIDTH> = 5;
    const FIRST_FEATURE    : logic<ADDR_WIDTH> = 6;
    const PREDICTION       : logic<ADDR_WIDTH> = 7;
    const NUM_VOTES        : logic<ADDR_WIDTH> = 8;
    const INTEN_SET        : logic<ADDR_WIDTH> = 9;
    const INTEN_CLR        : logic<ADDR_WIDTH> = 10;
    const INTFLAG          : logic<ADDR_WIDTH> = 11;
    const DBG              : logic<ADDR_WIDTH> = 12;

    const ENABLE_BIT: u8 = 0;
    const BUSY_BIT  : u8 = 1;

    var enable_reg      : logic;
    var next_enable     : logic;
    var next_user_enable: logic;

    assign enable = enable_reg;

    var num_trees_reg : logic<16>;
    var next_num_trees: logic<16>;
    assign num_trees      = num_trees_reg;

    var forest_start_addr_reg : logic<32>;
    var next_forest_start_addr: logic<32>;
    assign forest_start_addr      = forest_start_addr_reg;

    var num_features_reg : logic<4>;
    var next_num_features: logic<4>;
    assign num_features      = num_features_reg;

    var first_feature_reg : logic<32>;
    var next_first_feature: logic<32>;
    assign first_feature      = first_feature_reg;

    var inten_reg : logic;
    var next_inten: logic;

    var intflag_reg : logic;
    var next_intflag: logic;
    var prev_ready  : logic;

    let dbg: logic<32> = {
        5'b0,
        dbg_tree_idx,
        dbg_forest_state,
        dbg_forest_fetch_counter,
        dbg_tree_state,
        dbg_tree_fetch_counter
    };

    always_ff {
        if_reset {
            prev_ready = 0;
        } else {
            prev_ready = ready;
        }
    }

    assign interrupt = intflag_reg && inten_reg;

    // Write logic
    always_comb {
        // Defaults
        next_enable            = enable_reg;
        next_num_trees         = num_trees_reg;
        next_forest_start_addr = forest_start_addr_reg;
        next_num_features      = num_features_reg;
        next_first_feature     = first_feature_reg;
        next_inten             = inten_reg;
        next_intflag           = intflag_reg;
        next_user_enable       = 0;

        // Write to CTRL register
        if write && (address == CTRL) {
            next_user_enable = wdata[0];
            next_enable      = next_user_enable;
        }

        // Set CTRL register bits
        if write && (address == CTRL_SET) {
            // Can only write to ENABLE bit
            next_user_enable |= wdata[0];
            next_enable      =  next_user_enable;
        }

        // Clear CTRL register bits
        if write && (address == CTRL_CLR) {
            // Can only write to ENABLE bit
            next_user_enable &= ~wdata[0];
            next_enable      =  next_user_enable;
        }

        // Write to NUM_TREES register (enable-protected)
        if write && address == NUM_TREES && !enable {
            next_num_trees = wdata[15:0];
        }

        // Write to FOREST_START_ADDR register (enable-protected)
        if write && address == FOREST_START_ADDR && !enable {
            next_forest_start_addr = wdata;
        }

        // Write to NUM_FEATURES register (enable-protected)
        if write && address == NUM_FEATURES && !enable {
            next_num_features = wdata[3:0];
        }

        // Write to FIRST_FEATURE register (enable-protected)
        if write && address == FIRST_FEATURE && !enable {
            next_first_feature = wdata;
        }

        // Set INTEN register bits
        if write && (address == INTEN_SET) {
            // Can only write to 0th bit
            next_inten |= wdata[0];
        }

        // Clear INTEN register bits
        if write && (address == INTEN_CLR) {
            // Can only write to 0th bit
            next_inten &= ~wdata[0];
        }

        // Clear INTFLAG register bits
        if write && (address == INTFLAG) {
            // Can only write to 0th bit
            next_intflag &= ~wdata[0];
        }

        // Clear the enable bit if the forest
        // has just finished evaluating
        if done && !next_user_enable {
            next_enable = 0;
        }

        // Clear the interrupt flag when reading
        // the prediction register
        if read && address == PREDICTION {
            next_intflag = 0;
        }

        // Set the interrupt flag if ready
        if ready && !prev_ready {
            next_intflag = 1;
        }
    }

    // Read logic
    always_ff {
        // Default
        rdata = 0;

        // Read CTRL register
        if read && (address == CTRL || address == CTRL_SET || address == CTRL_CLR) {
            rdata = {30'b0, busy, enable};
        }

        // Read NUM_TREES register
        if read && address == NUM_TREES {
            rdata = {16'h0, num_trees_reg};
        }

        // Read FOREST_START_ADDR register
        if read && address == FOREST_START_ADDR {
            rdata = forest_start_addr_reg;
        }

        // Read NUM_FEATURES register
        if read && address == NUM_FEATURES {
            rdata = {28'h0, num_features_reg};
        }

        // Read FIRST_FEATURE register
        if read && address == FIRST_FEATURE {
            rdata = first_feature_reg;
        }

        // Read PREDICTION register
        if read && address == PREDICTION {
            rdata = prediction;
        }

        // Read NUM_VOTES register
        if read && address == NUM_VOTES {
            rdata = num_votes;
        }

        // Read INTEN register
        if read && (address == INTEN_SET || address == INTEN_CLR) {
            rdata = {31'b0, next_inten};
        }

        // Read INTFLAG register
        if read && address == INTFLAG {
            rdata = {31'b0, next_intflag};
        }

        if read && address == DBG {
            rdata = dbg;
        }
    }

    // Advance state machine
    always_ff {
        if_reset {
            enable_reg            = 0;
            num_trees_reg         = 0;
            forest_start_addr_reg = 0;
            num_features_reg      = 0;
            first_feature_reg     = 0;
            inten_reg             = 0;
            intflag_reg           = 0;
        } else {
            enable_reg            = next_enable;
            num_trees_reg         = next_num_trees;
            forest_start_addr_reg = next_forest_start_addr;
            num_features_reg      = next_num_features;
            first_feature_reg     = next_first_feature;
            inten_reg             = next_inten;
            intflag_reg           = next_intflag;
        }
    }
}
