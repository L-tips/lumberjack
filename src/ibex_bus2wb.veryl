/// Protocol converter from an Ibex bus master
/// to a Wishbone pipelined slave.
///
/// May only be used with slaves that meet the
/// following condition:
///
/// * May not stall, ie, must respond in the next cycle
///   after the request
module IbexBus2Wishbone #(
    param ADDR_WIDTH: u8 = 32,
    param DATA_WIDTH: u8 = 32,
) (
    master: modport IbexBus::slave            ,
    slave : modport memutils::Wishbone::master,
) {
    assign slave.cyc          = master.req;
    assign slave.stb          = master.req;
    assign slave.addr         = master.addr;
    assign slave.write_enable = master.we;
    assign slave.select       = master.be;
    assign slave.write_data   = master.wdata;

    assign master.rdata  = slave.read_data;
    assign master.rvalid = slave.ack;

    assign slave.lock = 0;
    let _stall    : logic = slave.stall;
    let _rty      : logic = slave.rty;

    // STALL, LOCK, ERR, RTY not supported by Ibex bus
}
