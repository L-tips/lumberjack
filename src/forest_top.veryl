/// Top-level random forest hardware accelerator.
///
/// Defines the interface and registers
/// to control the hardware.
module ForestTop::<L: Layout> #(
    /// Number of instances of tree cell evaluators
    param CELL_INSTANCES: u32 = 1,

    /// Use superscalar architecture
    param USE_SUPERSCALAR: bbool = true,

    /// Number of read ports the feature cache can support.
    /// When USE_SUPERSCALAR=true, this parameter must be larger
    /// or equal to 2.
    param READ_PORTS_PER_CACHE: u8 = 4,

    /// Size of the tree caches in 64 bit dwords
    param CELL_CACHE_SIZE: u64 = 1024,

    /// Inhibit model checking. Should only be used for development purposes.
    param INHIBIT_ERR: bbool = false,

    const WB_DATA_WIDTH: u8 = 32,
    const WB_ADDR_WIDTH: u8 = 32,

    const CELL_CACHE_ADDR_WIDTH: u32 = $clog2(CELL_CACHE_SIZE),
) (
    clk      : input clock           ,
    wb_rst   : input reset_async_high,
    rst_cache: input reset           ,

    /// Port to CPU bus for control/status
    control_port: modport memutils::Wishbone::slave,

    cell_cache_wb: modport memutils::Wishbone::slave [CELL_INSTANCES],

    /// Interrupt line
    interrupt: output logic,
) {
    const BITS_PER_COL         : u8  = 8;
    const CELL_CACHE_NUM_COL   : u8  = if USE_SUPERSCALAR ? node_layout::NODE_SIZE * 2 : node_layout::NODE_SIZE;
    const CELL_CACHE_DATA_WIDTH: u32 = CELL_CACHE_NUM_COL * BITS_PER_COL;

    var start_stb: logic;
    // var forest_start_addr  : L::RamAddr   ;
    var num_trees: L::TreeIdx;
    // var features_start_addr: L::RamAddr   ;
    var num_features: L::FeatureIdx;
    var busy        : logic        ;
    var ready       : logic        ;
    var error       : logic        ;
    var prediction  : L::Prediction;
    var num_votes   : L::NumVotes  ;

    let rst: reset = wb_rst as reset;

    var cells_busy: logic<CELL_INSTANCES>;

    inst feature_write_bus: memutils::ScratchpadRamPort #(
        // 32b word size, but features are 16b wide
        DATA_WIDTH: csr_types::<L>::DATA_WIDTH,
        ADDR_WIDTH: L::FEAT_IDX_WIDTH         ,
    );

    inst cell_cache_ports: memutils::BramPort [CELL_INSTANCES] #(
        NUM_COL   : CELL_CACHE_NUM_COL   ,
        COL_WIDTH : 8                    ,
        ADDR_WIDTH: CELL_CACHE_ADDR_WIDTH,
    );

    for i in 0..CELL_INSTANCES :convert_wb_cell_cache {
        inst wb_converter: Bram2Wishbone #(
            ADDR_WIDTH    : WB_ADDR_WIDTH        ,
            DATA_WIDTH    : WB_DATA_WIDTH        ,
            RAM_ADDR_WIDTH: CELL_CACHE_ADDR_WIDTH,
            RAM_DATA_WIDTH: CELL_CACHE_DATA_WIDTH,
        ) (
            clk                          ,
            rst     : wb_rst             ,
            ram_busy: cells_busy[i]      ,
            wb      : cell_cache_wb[i]   ,
            ram_port: cell_cache_ports[i],
        );
    }

    inst evaluator: Forest::<L> #(
        CELL_INSTANCES        ,
        USE_SUPERSCALAR       ,
        READ_PORTS_PER_CACHE  ,
        CELL_CACHE_SIZE       ,
        INHIBIT_ERR           ,
    ) (
        clk                                  ,
        rst                                  ,
        rst_cell_caches   : rst_cache        ,
        enable            : start_stb        ,
        num_trees                            ,
        num_features                         ,
        busy                                 ,
        ready                                ,
        error                                ,
        prediction                           ,
        num_votes                            ,
        feature_write_port: feature_write_bus,
        cell_cache_ports                     ,
        cells_busy                           ,
    );

    // Control port is byte-addressed, but CSRs are word-addressed
    let word_idx   : csr_types::<L>::Data    = control_port.addr >> 2;
    let csr_address: csr_types::<L>::Address = word_idx as csr_types::<L>::Address;

    var csr_wdata: csr_types::<L>::Data;
    var csr_rdata: csr_types::<L>::Data;

    let csr_write_req: logic = control_port.write_enable && control_port.valid_request();
    let csr_read_req : logic = !control_port.write_enable && control_port.valid_request();

    inst csr: CsrInterface::<L> #(
        CELL_INSTANCES  ,
    ) (
        clk                                  ,
        rst                                  ,
        address           : csr_address      ,
        write             : csr_write_req    ,
        read              : csr_read_req     ,
        wdata             : csr_wdata        ,
        rdata             : csr_rdata        ,
        start_stb                            ,
        num_trees                            ,
        num_features                         ,
        ready                                ,
        busy                                 ,
        error                                ,
        prediction                           ,
        num_votes                            ,
        interrupt                            ,
        feature_write_port: feature_write_bus,
    );

    var prev_select: logic<4>;

    always_ff (clk, rst) {
        if_reset {
            control_port.ack = 0;
            prev_select      = 0;
        } else {
            control_port.ack = control_port.valid_request();
            prev_select      = control_port.select;
        }
    }

    always_comb {
        csr_wdata              = 0;
        control_port.read_data = 0;

        for i in 0..4 {
            if control_port.select[i] && control_port.valid_request() {
                if control_port.write_enable {
                    csr_wdata[(i * 8)+:8] = control_port.write_data[(i * 8)+:8];
                }
            }

            // Only show requested bytes during read
            if prev_select[i] && control_port.ack {
                control_port.read_data[(i * 8)+:8] = csr_rdata[(i * 8)+:8];
            }
        }
    }
}
