pub module Forest::<L: Layout> (
    clk: input clock,
    rst: input reset,

    enable: input logic,

    forest_start_addr: input L::RamAddr,
    num_trees        : input L::TreeIdx,

    features_start_addr: input L::RamAddr   ,
    num_features       : input L::FeatureIdx,

    busy      : output lbool        ,
    ready     : output lbool        ,
    error     : output lbool        ,
    prediction: output L::Prediction,
    num_votes : output L::NumVotes  ,

    done: output lbool,

    dma_port: modport memutils::Wishbone::master,
) {
    enum State {
        idle,
        fetch_features,
        evaluate_trees,
    }

    struct VoteResult {
        /// The most voted class
        max_vote_class: L::Prediction,
        /// The number of votes that has the most
        /// voted class
        max_vote: L::TreeIdx,
    }

    inst ram_bus_mux: memutils::Wishbone [2] #( ADDR_WIDTH: L::RAM_ADDR_WIDTH, DATA_WIDTH: L::RAM_DATA_WIDTH );

    var state             : State        ;
    var next_state        : State        ;
    var fetch_counter     : L::FeatureIdx;
    var next_fetch_counter: L::FeatureIdx;

    var done_reg : lbool;
    var next_done: lbool;
    assign done      = next_done;

    var feature_ptr     : L::RamAddr;
    var next_feature_ptr: L::RamAddr;

    // If we're evaluating trees, we delegate control of
    // the RAM bus to the tree evaluater. Otherwise we keep
    // control so we can use it to fetch features.
    let master_select: logic = state == State::evaluate_trees;

    // New evaluation request incoming
    let start_eval    : lbool = state == State::idle && enable && !done_reg;
    let fetch_complete: lbool = fetch_counter == num_features - 1;

    inst ram_demux: memutils::WishboneDemux #(
        ADDR_WIDTH: L::RAM_ADDR_WIDTH,
        DATA_WIDTH: L::RAM_DATA_WIDTH,
        // NUM_SLAVES: 2 ,
    ) (
        masters      : ram_bus_mux,
        slave        : dma_port   ,
        master_select             ,
    );

    inst feature_write_port: memutils::ScratchpadRamPort #( DATA_WIDTH: L::FEATURE_WIDTH, ADDR_WIDTH: L::FEAT_IDX_WIDTH );
    inst feature_read_port : memutils::ScratchpadRamPort [1] #( DATA_WIDTH: L::FEATURE_WIDTH, ADDR_WIDTH: L::FEAT_IDX_WIDTH );

    inst feature_cache: memutils::ScratchpadRam #(
        READ_PORTS: 1                  ,
        DATA_WIDTH: L::FEATURE_WIDTH   ,
        DEPTH     : L::MAX_NUM_FEATURES,
    ) (
        clk  ,
        rst  ,

        write: feature_write_port,
        read : feature_read_port ,
    );

    var tree_ready: lbool;
    var tree_busy : lbool;
    var tree_error: lbool;

    var tree_idx     : L::TreeIdx;
    var next_tree_idx: L::TreeIdx;

    var start_tree     : lbool;
    var next_start_tree: lbool;

    var next_ready: lbool;

    let tree_node_addr : L::RamAddr    = tree_idx * L::NODE_SIZE + forest_start_addr;
    var tree_prediction: L::Prediction;

    // Hold the votes counter and tree
    // in reset so that it holds all 0s when we start a new
    // forest prediction
    var tree_rst  : reset_async_low;
    let tree_rst_i: reset           = tree_rst as reset;

    inst tree: TreePredictor::<L> (
        clk            ,
        rst: tree_rst_i,

        first_node_addr  : tree_node_addr ,
        forest_start_addr                 ,
        ready            : tree_ready     ,
        busy             : tree_busy      ,
        error            : tree_error     ,
        start            : start_tree     ,
        prediction       : tree_prediction,

        feature_port: feature_read_port[0],
        dma_port    : ram_bus_mux[1]      ,
    );

    inst votes_write_port: memutils::ScratchpadRamPort #( DATA_WIDTH: L::TREE_IDX_WIDTH, ADDR_WIDTH: L::CLASS_IDX_WIDTH );
    inst votes_read_port : memutils::ScratchpadRamPort [1] #( DATA_WIDTH: L::TREE_IDX_WIDTH, ADDR_WIDTH: L::CLASS_IDX_WIDTH );

    inst votes_ram: memutils::ScratchpadRam #(
        // Max # of trees
        DATA_WIDTH: L::TREE_IDX_WIDTH,
        // Max number of classes
        DEPTH: L::MAX_NUM_CLASSES,
    ) (
        clk            ,
        rst: tree_rst_i,

        write: votes_write_port,
        read : votes_read_port ,
    );

    var votes     : VoteResult;
    var next_votes: VoteResult;

    var prev_wb_complete: lbool     ;
    var addr            : L::RamAddr;
    var next_addr       : L::RamAddr;

    assign ram_bus_mux[0].addr = next_addr;

    always_ff (clk, rst) {
        if_reset {
            prev_wb_complete = 0;
            addr             = 0;
        } else {
            prev_wb_complete = ram_bus_mux[0].valid_request();
            addr             = next_addr;
        }
    }

    always_comb {
        next_start_tree = false;
        // TODO: hardcoded
        next_tree_idx = 0;
        next_ready    = ready;
        next_done     = false;

        next_state         = state;
        next_fetch_counter = fetch_counter;
        next_feature_ptr   = feature_ptr;

        next_votes = votes;

        // Read votes
        // TODO: hardcoded
        votes_read_port[0].address = tree_prediction;

        // Default: don't write features to cache
        feature_write_port.write_enable = false;
        feature_write_port.address      = 0;
        feature_write_port.data         = 0;

        // RAM control defaults
        next_addr          = addr;
        ram_bus_mux[0].stb = false;
        ram_bus_mux[0].cyc = false;


        // Allow shutting down the evaluation early by deasserting enable
        if !enable {
            next_state = State::idle;
        } else {

            case state {
                State::idle: {
                    if start_eval {
                        next_state         = State::fetch_features;
                        next_feature_ptr   = features_start_addr;
                        next_ready         = false;
                        next_fetch_counter = 0;

                        // Start RAM read request
                        ram_bus_mux[0].stb = true;
                        ram_bus_mux[0].cyc = true;
                        next_addr          = features_start_addr;
                    }
                }

                State::fetch_features: {
                    // Continue the read transaction, only if bus isn't stalled
                    ram_bus_mux[0].stb = true;
                    ram_bus_mux[0].cyc = true;

                    // Store incoming data in cache
                    if ram_bus_mux[0].ack && prev_wb_complete {
                        // Fetch next word
                        next_fetch_counter += 1;
                        next_addr          =  feature_ptr + next_fetch_counter * 4;

                        // Store the data returned from memory
                        feature_write_port.write_enable = 1;
                        feature_write_port.address      = fetch_counter;
                        feature_write_port.data         = ram_bus_mux[0].read_data;

                        // We've fetched all the features and stored them
                        // into cache. Time to move on to evaluation step
                        if fetch_complete {
                            // Release the bus
                            ram_bus_mux[0].stb = false;
                            ram_bus_mux[0].cyc = false;

                            next_state         = State::evaluate_trees;
                            next_fetch_counter = 0;

                            // Kick off the tree evaluator
                            next_start_tree = true;
                        }
                    }
                }

                State::evaluate_trees: {
                    next_tree_idx   = tree_idx;
                    next_start_tree = false;

                    if tree_error {
                        next_state = State::idle;
                        next_done  = true;
                    }
                    // If the tree is not busy, this means
                    // we start a new tree prediction
                     else if !tree_busy {
                        if tree_idx <: num_trees - 1 {
                            next_start_tree = true;
                            next_ready      = false;

                            // Special-case the first tree prediction, where
                            // READY will be set to 0. For all subsequent predictions,
                            // READY will be 1.
                            if tree_ready {
                                next_tree_idx += 1;
                            }

                        } else {
                            next_tree_idx = 0;
                            next_ready    = true;
                            next_state    = State::idle;
                            next_done     = true;
                        }
                    }
                }

                default: {
                    // TODO: do nothing?
                }
            }
        }
    }

    // Voting logic when tree returns a result
    always_ff (clk, rst) {
        if_reset {
            votes.max_vote       = 0;
            votes.max_vote_class = 0;
        } else {
            // Default: no vote write
            votes_write_port.write_enable = false;
            votes_write_port.address      = 0;
            votes_write_port.data         = 0;

            // If the tree is ready, we count its
            // vote and store it into the scratchpad.
            if tree_ready {
                // TODO: hardcoded
                votes_write_port.write_enable = true;
                votes_write_port.address      = tree_prediction;
                votes_write_port.data         = votes_read_port[0].data + 1;

                // Update max vote and index if needed
                if (votes_read_port[0].data + 1 >: votes.max_vote) {
                    votes.max_vote       = votes_read_port[0].data + 1;
                    votes.max_vote_class = tree_prediction;
                }
            }
        }
    }

    // Advance state machine
    always_ff (clk, rst) {
        if_reset {
            tree_idx   = 0;
            tree_rst   = 0;
            start_tree = false;
            ready      = false;

            state         = State::idle;
            fetch_counter = 0;
            feature_ptr   = 0;

            done_reg = false;
        } else {
            tree_idx   = next_tree_idx;
            start_tree = next_start_tree;
            ready      = next_ready;

            state         = next_state;
            fetch_counter = next_fetch_counter;
            feature_ptr   = next_feature_ptr;

            done_reg = next_done;

            tree_rst = next_state != State::idle;
        }
    }

    // TODO: hardcoded
    assign prediction = votes.max_vote_class;
    assign num_votes  = votes.max_vote;

    assign busy  = state != State::idle;
    assign error = tree_error;

    // TODO: hardcoded
    assign ram_bus_mux[0].select     = 4'b1111;
    assign ram_bus_mux[0].write_data = 0;
    assign ram_bus_mux[0].lock       = false;
}
