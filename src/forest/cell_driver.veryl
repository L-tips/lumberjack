module CellOrchestrator::<L: Layout> #(
    param CELL_CACHE_ADDR_WIDTH: u32 = 16,
    param VOTE_FIFO_DEPTH      : u8  = 2 ,
) (
    clk: input clock,
    rst: input reset,

    start_forest: input lbool,

    cell_busy      : input lbool        ,
    cell_ready     : input lbool        ,
    cell_error     : input lbool        ,
    cell_prediction: input L::Prediction,
    cell_rst       : input lbool        ,

    vote_valid: output lbool        ,
    vote_ack  : input  lbool        ,
    vote_class: output L::Prediction,

    busy_o : output lbool,
    ready_o: output lbool,
    error_o: output lbool,

    start_cell      : output lbool                                         ,
    tree_header_addr: output logic                  <CELL_CACHE_ADDR_WIDTH>,
    tree_header_data: input  node_layout::TreeHeader                       ,
    header_valid    : input  lbool                                         ,
) {
    type NodePtr = logic<CELL_CACHE_ADDR_WIDTH>;

    var tree_idx             : NodePtr;
    var next_tree_idx        : NodePtr;
    var next_tree_header_addr: NodePtr;

    var next_start_cell: lbool;
    var prev_cell_ready: lbool;

    // Converts the potentially latched cell_ready signal into a strobe
    let cell_prediction_arrived: lbool = cell_ready && !prev_cell_ready;

    var vote_fifo_empty: lbool        ;
    var vote_fifo_full : lbool        ;
    var vote_fifo_rdata: L::Prediction;

    inst vote_fifo: VoteFifo::<L> #(
        DEPTH: VOTE_FIFO_DEPTH,
    ) (
        clk                                               ,
        rst                                               ,
        write_enable: cell_prediction_arrived && !vote_ack,
        write_data  : cell_prediction                     ,
        read_enable : vote_ack && !vote_fifo_empty,
        read_data   : vote_fifo_rdata                     ,
        empty       : vote_fifo_empty                     ,
        full        : vote_fifo_full                      ,
    );

    // Bypass: if prediction arrives and is acked same cycle and FIFO is empty,
    // forward directly without touching the FIFO
    let bypass: lbool = cell_prediction_arrived && vote_ack && vote_fifo_empty;
    assign vote_valid = !vote_fifo_empty || cell_prediction_arrived;
    assign vote_class = if bypass ? cell_prediction : vote_fifo_rdata;

    let all_votes_registered: lbool = !cell_prediction_arrived && vote_fifo_empty;

    let vote_stall: lbool = vote_fifo_full;

    // Return ready immediately when the cell is empty
    var empty_forest_ready     : lbool;
    var next_empty_forest_ready: lbool;

    var num_trees_in_cell     : L::TreeIdx;
    var next_num_trees_in_cell: L::TreeIdx;

    let first_header_valid: lbool = header_valid && tree_idx == 0;

    assign busy_o  = (cell_busy || next_start_cell || !all_votes_registered) && !empty_forest_ready;
    assign ready_o = (cell_ready && !next_start_cell && all_votes_registered) || empty_forest_ready;
    assign error_o = cell_error && num_trees_in_cell != 0;

    always_comb {
        next_tree_idx         = tree_idx;
        next_tree_header_addr = tree_header_addr;
        next_start_cell       = false;

        next_num_trees_in_cell = num_trees_in_cell;

        next_empty_forest_ready = empty_forest_ready;

        if first_header_valid {
            next_num_trees_in_cell = tree_header_data.trees_in_cell as L::TreeIdx;
        }

        if start_cell {
            next_start_cell = false;
        }

        if cell_error {
            next_start_cell = false;
        } else if cell_prediction_arrived {
            // Only advance to next tree if vote buffer is clear or being
            // cleared this cycle, so we don't overwrite an unserviced vote
            if !vote_stall && next_tree_idx as L::TreeIdx <: num_trees_in_cell - 1 {
                next_tree_idx += 1;
                // Tree header contains the tree's length
                next_tree_header_addr = tree_header_addr + tree_header_data.tree_len as NodePtr;
                next_start_cell       = true;
            }
        }

        if start_forest {
            next_tree_idx         = 0;
            next_tree_header_addr = 0;
            next_start_cell       = true;
        }

        // If num_trees == 0, we're done
        if first_header_valid && next_num_trees_in_cell == 0 {
            next_empty_forest_ready = true;
            next_start_cell         = false;
        }

        if next_start_cell || cell_rst {
            next_empty_forest_ready = false;
        }

    }

    always_ff (clk, rst) {
        if_reset {
            tree_idx         = 0;
            tree_header_addr = 0;
            // tree_rst   = false;
            start_cell         = false;
            prev_cell_ready    = false;
            empty_forest_ready = false;
            num_trees_in_cell  = 0;
        } else {
            tree_idx           = next_tree_idx;
            tree_header_addr   = next_tree_header_addr;
            start_cell         = next_start_cell;
            prev_cell_ready    = cell_ready;
            empty_forest_ready = next_empty_forest_ready;
            num_trees_in_cell  = next_num_trees_in_cell;

        }
    }
}
