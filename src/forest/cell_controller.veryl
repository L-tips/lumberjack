import node_layout::NumTrees;

module CellController::<L: Layout> #(
    param CELL_CACHE_ADDR_WIDTH: u32 = 16,
    param VOTE_FIFO_DEPTH      : u32 = 4 ,
) (
    clk: input clock,
    rst: input reset,

    // Start a brand new evaluation
    start_forest: input lbool,

    // Cell control signals
    cell_start             : output lbool                ,
    cell_restart           : output lbool                ,
    cell_pred_valid        : input  lbool                ,
    cell_prediction        : input  L::Prediction        ,
    cell_pred_ack          : output lbool                ,
    num_trees_in_cell      : input  node_layout::NumTrees,
    num_trees_in_cell_valid: input  lbool                ,
    cell_busy              : input  lbool                ,

    // Vote arbiter signals
    vote_valid: output lbool        ,
    vote_ack  : input  lbool        ,
    vote_class: output L::Prediction,

    // Output signals to CSRs
    /// Evaluation is in progress. Goes low when all trees in cache have been evaluated.
    busy_o: output lbool,
    /// Evaluation ready. Goes high when all trees in cache have been evaluated.
    ready_o: output lbool,
) {

    var fifo_empty      : lbool;
    var fifo_full       : lbool;
    var fifo_nearly_full: lbool;
    // A vote is secured exactly when it is pushed.
    let fifo_push: lbool = cell_pred_ack;
    let fifo_pop : lbool = vote_ack && !fifo_empty;

    // Tree accounting. `trees_total` is latched from the cell 2 cycles after
    // start && restart; `trees_done` counts secured votes.
    var trees_total_q: NumTrees;
    var trees_total  : NumTrees;
    var trees_done_q : NumTrees;
    var trees_done   : NumTrees;
    var forest_active: lbool   ;
    var next_active  : lbool   ;

    inst votes_fifo: $std::fifo #(
        TYPE     : L::Prediction      ,
        DEPTH    : VOTE_FIFO_DEPTH    ,
        THRESHOLD: VOTE_FIFO_DEPTH - 1,
        // combinational o_full/o_empty
        FLAG_FF_OUT: false,
        // registered o_data
        DATA_FF_OUT  : true ,
        RESET_RAM    : false,
        RESET_DATA_FF: true ,
        CLEAR_DATA   : false,
        PUSH_ON_CLEAR: false,
    ) (
        i_clk: clk,
        i_rst: rst,
        // flush stale votes on a new forest eval
        i_clear      : start_forest    ,
        o_empty      : fifo_empty      ,
        o_almost_full: fifo_nearly_full,
        o_full       : fifo_full       ,
        o_word_count : _               ,
        i_push       : fifo_push       ,
        i_data       : cell_prediction ,
        i_pop        : fifo_pop        ,
        o_data       : vote_class      ,
    );

    // The cell is stalled only when the FIFO cannot accept the vote.
    // Ack is otherwise unconditional -- predictions go indiscriminately in.
    // Stall one slot early so the registered flag's staleness can never overflow.
    assign cell_pred_ack = !fifo_full && cell_pred_valid;
    assign vote_valid    = !fifo_empty;

    // More trees remain after the one whose vote we are securing now.
    let more_trees: lbool = trees_done <: trees_total;

    // Launch the next traversal coincidentally with the ack, unless this was
    // the last tree. `restart` only on a fresh forest.
    assign cell_start   = (fifo_push && more_trees) || start_forest;
    assign cell_restart = start_forest;

    var empty_cache     : lbool;
    var next_empty_cache: lbool;

    let all_trees_done_q: lbool = forest_active && trees_total_q != 0 && trees_done_q >= trees_total_q;

    assign busy_o  = forest_active && !ready_o;
    assign ready_o = fifo_empty && !cell_busy && !start_forest && (all_trees_done_q || empty_cache);

    always_comb {
        trees_total      = trees_total_q;
        trees_done       = trees_done_q;
        next_active      = forest_active;
        next_empty_cache = empty_cache;

        if start_forest {
            trees_total      = 0;
            trees_done       = 0;
            next_active      = true;
            next_empty_cache = false;
        } else {
            // trees_in_cell is valid 2 cycles after start && restart, and the
            // cell holds it thereafter. Latch it once it becomes valid
            if forest_active && num_trees_in_cell_valid {
                if num_trees_in_cell == 0 {
                    next_empty_cache = true;
                } else {
                    trees_total = num_trees_in_cell;
                }
            }

            if fifo_push {
                trees_done = trees_done_q + 1;
            }

            // Empty cache: the cell bails out and never predicts, so retire
            // the forest as soon as we know the count is zero.
            if forest_active && !cell_busy && trees_total_q == 0 {
                next_active = false;
            }
        }
    }

    always_ff (clk, rst) {
        if_reset {
            trees_total_q = 0;
            trees_done_q  = 0;
            forest_active = false;
            empty_cache   = false;
        } else {
            trees_total_q = trees_total;
            trees_done_q  = trees_done;
            forest_active = next_active;
            empty_cache   = next_empty_cache;
        }

    }
}
