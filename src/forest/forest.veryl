pub module Forest::<L: Layout> #(
    /// Number of instances of tree cell evaluators
    param CELL_INSTANCES: u32 = 1,

    /// Use superscalar architecture
    param USE_SUPERSCALAR: bbool = true,

    /// Number of read ports the feature cache can support.
    /// When USE_SUPERSCALAR=true, this parameter must be larger
    /// or equal to 2.
    param READ_PORTS_PER_CACHE: u8 = 4,

    /// Size of the tree caches in 64 bit dwords
    param CELL_CACHE_SIZE: u64 = 1024,

    /// Inhibit model checking. Should only be used for development purposes.
    param INHIBIT_ERR: bbool = false,

    const CELL_CACHE_ADDR_WIDTH: u32 = $clog2(CELL_CACHE_SIZE),
) (
    clk            : input clock,
    rst            : input reset,
    rst_cell_caches: input reset,

    enable: input logic,

    num_trees   : input L::TreeIdx   ,
    num_features: input L::FeatureIdx,

    busy      : output lbool        ,
    ready     : output lbool        ,
    error     : output lbool        ,
    prediction: output L::Prediction,
    num_votes : output L::NumVotes  ,

    feature_write_port: modport memutils::ScratchpadRamPort::write_slave                                 ,
    cell_cache_ports  : modport memutils::BramPort::slave                                [CELL_INSTANCES],
    cells_busy        : output  logic                                   <CELL_INSTANCES>                 ,
) {
    const READ_PORTS_PER_CACHE_U32: u32 = READ_PORTS_PER_CACHE as u32;
    const PORTS_PER_TREE          : u32 = if USE_SUPERSCALAR ? 2 : 1;
    // Our caches have 4 read ports. Superscalar evaluators need 2 ports each, otherwise 1 port.
    const CELL_INSTANCES_PER_CACHE: u32 = READ_PORTS_PER_CACHE_U32 / PORTS_PER_TREE;
    // Ceiling div
    const NUM_FEAT_BUF: u32 = (CELL_INSTANCES + CELL_INSTANCES_PER_CACHE - 1) / CELL_INSTANCES_PER_CACHE;

    const BITS_PER_COL      : u8 = 8;
    const CELL_CACHE_NUM_COL: u8 = if USE_SUPERSCALAR ? node_layout::NODE_SIZE * 2 : node_layout::NODE_SIZE;

    // All read ports are (unfortunately) stored in a flat array.
    inst feature_read_port: memutils::ScratchpadRamPort [NUM_FEAT_BUF * READ_PORTS_PER_CACHE_U32] #(
        DATA_WIDTH: csr_types::<L>::DATA_WIDTH,
        ADDR_WIDTH: L::FEAT_IDX_WIDTH         ,
    );

    for i in 0..NUM_FEAT_BUF :inst_caches {
        const BASE_PORT: u32 = i * READ_PORTS_PER_CACHE_U32;
        inst feature_cache: memutils::ScratchpadRam #(
            READ_PORTS: READ_PORTS_PER_CACHE,
            // 32b wide, but features are 16b each
            DATA_WIDTH: csr_types::<L>::DATA_WIDTH,
            DEPTH     : L::MAX_NUM_FEATURES       ,
        ) (
            clk                      ,
            rst                      ,
            write: feature_write_port,
            // Each cache gets its appropriate slice of read ports
            read: feature_read_port[BASE_PORT+:READ_PORTS_PER_CACHE_U32],
        );
    }

    var cells_ready: logic<CELL_INSTANCES>;
    var cells_error: logic<CELL_INSTANCES>;

    // Start a new evaluation when enabled and not already running or done
    var start_eval_reg: lbool;
    let start_eval    : lbool = start_eval_reg;

    let rst_votes: reset = ~start_eval & rst;

    // Base trees per cell and remainder
    let trees_per_cell_base: L::TreeIdx = num_trees / CELL_INSTANCES as L::TreeIdx;
    let trees_remainder    : L::TreeIdx = num_trees % CELL_INSTANCES as L::TreeIdx;

    var vote_ack  : logic<CELL_INSTANCES>;
    var vote_valid: logic<CELL_INSTANCES>;

    var vote_classes: L::Prediction [CELL_INSTANCES];

    var votes: forest_types::VoteResult::<L>;

    inst vote_arbiter: VotesArbiter::<L> #(
        NUM_REQUESTERS: CELL_INSTANCES            ,
        ADDR_WIDTH    : $clog2(L::MAX_NUM_CLASSES),
    ) (
        clk                  ,
        rst    : rst_votes   ,
        valid  : vote_valid  ,
        classes: vote_classes,
        ack    : vote_ack    ,
        votes                ,
    );

    var cells_error_posedge    : lbool          ;
    var cells_error_posedge_reg: lbool          ;
    let rst_cells_low          : reset_async_low = !(cells_error_posedge_reg as reset_async_high
        || !rst as reset_async_low);
    let rst_cells              : reset           = rst_cells_low as reset;

    inst detect_error_edge: $std::edge_detector #(
        WIDTH        : 1    ,
        INITIAL_VALUE: false,
    ) (
        i_clk    : clk                ,
        i_rst    : rst                ,
        i_clear  : false              ,
        i_data   : |cells_error       ,
        o_posedge: cells_error_posedge,
        o_negedge: _                  ,
        o_edge   : _                  ,
    );

    for i in 0..CELL_INSTANCES :inst_tree_cells {
        const CACHE_IDX: u32 = i / CELL_INSTANCES_PER_CACHE;
        const SLOT_IDX : u32 = i % CELL_INSTANCES_PER_CACHE;
        const BASE_PORT: u32 = CACHE_IDX * READ_PORTS_PER_CACHE_U32 + SLOT_IDX * PORTS_PER_TREE;

        // Cell i gets base + 1 if i < remainder, else base
        let num_trees_in_cell: L::TreeIdx = trees_per_cell_base + (if i as L::TreeIdx <: trees_remainder ? 1 : 0);

        var start_cell: lbool;

        var cell_busy      : lbool        ;
        var cell_ready     : lbool        ;
        var cell_error     : lbool        ;
        var cell_prediction: L::Prediction;

        var tree_header_addr: logic<CELL_CACHE_ADDR_WIDTH>;

        var tree_header_data: node_layout::TreeHeader;

        inst orchestrator: CellOrchestrator::<L> #(
            CELL_CACHE_ADDR_WIDTH  ,
        ) (
            clk                                   ,
            rst              : rst_cells          ,
            num_trees_in_cell                     ,
            start_forest     : start_eval         ,
            cell_busy                             ,
            cell_ready                            ,
            cell_error                            ,
            cell_prediction                       ,
            cell_rst         : cells_error_posedge,
            start_cell                            ,
            tree_header_addr                      ,
            tree_header_data                      ,
            ready_o          : cells_ready[i]     ,
            busy_o           : cells_busy[i]      ,
            error_o          : cells_error[i]     ,
            vote_valid       : vote_valid[i]      ,
            vote_class       : vote_classes[i]    ,
            vote_ack         : vote_ack[i]        ,
        );

        inst tree: TreeCell::<L> #(
            USE_SUPERSCALAR  ,
            CELL_CACHE_SIZE  ,
            INHIBIT_ERR      ,
        ) (
            clk                                                           ,
            rst             : rst_cells                                   ,
            rst_cache       : rst_cell_caches                             ,
            tree_header_addr                                              ,
            tree_header_data                                              ,
            ready           : cell_ready                                  ,
            busy            : cell_busy                                   ,
            error           : cell_error                                  ,
            start           : start_cell                                  ,
            prediction      : cell_prediction                             ,
            feature_ports   : feature_read_port[BASE_PORT+:PORTS_PER_TREE],
            ram_port        : cell_cache_ports[i]                         ,
        );
    }

    assign prediction = votes.max_vote_class;
    assign num_votes  = votes.max_vote;

    assign busy  = |cells_busy & !error;
    assign ready = &cells_ready;

    always_ff (clk, rst) {
        if_reset {
            start_eval_reg          = false;
            error                   = false;
            cells_error_posedge_reg = false;
        } else {
            start_eval_reg          = enable && !busy;
            cells_error_posedge_reg = cells_error_posedge;
            if cells_error_posedge {
                error = true;
            } else if enable {
                error = false;
            }
        }
    }

}
