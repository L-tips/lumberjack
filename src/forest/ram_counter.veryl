
/// A RAM with asynchronous reads and synchronous writes, where the only
/// possible write operation (apart from resetting the counters) is to
/// increment the counter at each address.
module RamCounter #(
    param DATA_WIDTH: u32 = 32           ,
    param DEPTH     : u32 = 32           ,
    const ADDR_WIDTH: u32 = $clog2(DEPTH),
) (
    clk: input clock,
    rst: input reset,

    inc_address: input logic<ADDR_WIDTH>,
    inc_en     : input lbool            ,

    read_address: input logic<ADDR_WIDTH>,
    read_data: output logic<DATA_WIDTH>,
) {
    var mem: logic<DATA_WIDTH> [DEPTH];

    // let raw_read: logic<DATA_WIDTH> = mem[read_address];

    // // Bypass: if we're writing to the same address we're reading,
    // // forward the post-increment value instead of the stale RAM output
    // let write_read_collision: lbool = inc_en && (inc_address == read_address);
    // assign read_data = if write_read_collision ? raw_read + 1 : raw_read;

    assign read_data = mem[read_address];

    always_ff {
        if_reset {
            for i in 0..DEPTH {
                mem[i] = 0;
            }
        } else {
            if inc_en {
                mem[inc_address] += 1;
            }
        }
    }

}
