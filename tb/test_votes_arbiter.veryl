module TestVotesArbiter #(
    const NUM_REQUESTERS: u32 = 4,
    const ADDR_WIDTH    : u32 = 9,
) (
    clk: input clock,
    rst: input reset,

    valid  : input  logic<NUM_REQUESTERS>                 ,
    classes: input  logic<ADDR_WIDTH>     [NUM_REQUESTERS],
    ack    : output logic<NUM_REQUESTERS>                 ,

    winning_class: output test_layout::Prediction,
    winning_votes: output test_layout::NumVotes  ,
) {

    inst votes_arbiter: VotesArbiter::<test_layout> #(
        NUM_REQUESTERS  ,
        ADDR_WIDTH      ,
    ) (
        clk            ,
        rst            ,
        valid          ,
        classes        ,
        ack            ,
        winning_class  ,
        winning_votes  ,
    );
}

#[test(test_votes_arbiter, TestVotesArbiter)]
include (cocotb, "../tb/test_votes_arbiter.py");
