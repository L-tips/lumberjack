module TestForest_2Cells (
    clk: input clock,
    rst: input reset,

    enable: input logic,

    num_trees   : input test_layout::TreeIdx   ,
    num_features: input test_layout::FeatureIdx,

    busy : output lbool,
    ready: output lbool,
    error: output lbool,

    prediction: output test_layout::Prediction,
    num_votes : output test_layout::NumVotes  ,
) {
    const CELL_CACHE_SIZE      : u64 = 4096;
    const CELL_CACHE_ADDR_WIDTH: u32 = $clog2(CELL_CACHE_SIZE);

    const CELL_INSTANCES      : u32   = 2;
    const READ_PORTS_PER_CACHE: u32   = 1;
    const USE_SUPERSCALAR     : bbool = false;
    const CELL_CACHE_NUM_COL  : u8    = if USE_SUPERSCALAR ? node_layout::NODE_SIZE * 2 : node_layout::NODE_SIZE;

    inst feature_write_bus: memutils::ScratchpadRamPort #(
        DATA_WIDTH: node_layout::FEATURE_WIDTH ,
        ADDR_WIDTH: test_layout::FEAT_IDX_WIDTH,
    );

    inst cell_cache_ports: memutils::BramPort [CELL_INSTANCES] #(
        NUM_COL   : CELL_CACHE_NUM_COL   ,
        COL_WIDTH : 8                    ,
        ADDR_WIDTH: CELL_CACHE_ADDR_WIDTH,
    );

    inst forest: Forest::<test_layout> #(
        CELL_CACHE_SIZE            ,
        CELL_INSTANCES      : 2    ,
        USE_SUPERSCALAR     : false,
        READ_PORTS_PER_CACHE: 1    ,
    ) (
        clk                                  ,
        rst                                  ,
        rst_cell_caches   : rst              ,
        enable                               ,
        num_trees                            ,
        num_features                         ,
        busy                                 ,
        ready                                ,
        error                                ,
        prediction                           ,
        num_votes                            ,
        done              : _                ,
        feature_write_port: feature_write_bus,
        cell_cache_ports                     ,
        cells_busy        : _                ,
    );
}

#[test(test_forest_2c, TestForest_2Cells)]
embed (cocotb) py{{{

import cocotb
import test_forest
import test_cases

@cocotb.test()
async def forest_2c_aligned(dut):
    cases = [
        test_cases.TC_ALIGNED_2CELLS,
    ]

    await test_forest.test_forest(dut, cases)


@cocotb.test()
async def forest_2c_misaligned(dut):
    cases = [
        test_cases.TC_MISALIGNED_2CELLS,
    ]

    await test_forest.test_forest(dut, cases)

}}}
