package test_layout for Layout {
    // ------
    //Use deliberately weird numbers here to test the forest layout
    const MAX_NUM_FEATURES: u32 = 258;
    const MAX_NUM_CLASSES : u32 = 300;
    const MAX_NUM_TREES   : u32 = 1025;
    // ------

    const RAM_ADDR_WIDTH: u8 = 32;
    const RAM_DATA_WIDTH: u8 = 32;

    const TREE_IDX_WIDTH : u32 = $clog2(MAX_NUM_TREES);
    const CLASS_IDX_WIDTH: u32 = $clog2(MAX_NUM_CLASSES);
    const FEAT_IDX_WIDTH : u32 = $clog2(MAX_NUM_FEATURES);

    type RamAddr    = logic<RAM_ADDR_WIDTH> ;
    type TreeIdx    = logic<TREE_IDX_WIDTH> ;
    type FeatureIdx = logic<FEAT_IDX_WIDTH> ;
    type Prediction = logic<CLASS_IDX_WIDTH>;
    type NumVotes   = logic<TREE_IDX_WIDTH> ;
}
