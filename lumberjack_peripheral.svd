<peripheral>
      <name>RF_ACCELERATOR</name>
      <description>Lumberjack Random Forest hardware accelerator</description>
      <version>1</version>
      <baseAddress>0x80005000</baseAddress>
      <size>32</size>

      <addressBlock>
        <offset>0</offset>
        <size>0x1000</size>
        <usage>registers</usage>
      </addressBlock>

      <interrupt>
        <name>RF_IRQ</name>
        <value>2</value>
      </interrupt>

      <registers>

        <register>
          <name>CTRL</name>
          <description>Control and status</description>
          <addressOffset>0x0000</addressOffset>
          <resetValue>0x00000000</resetValue>
          <fields>

            <field>
              <name>ENABLE</name>
              <description>Accelerator is enabled</description>
              <bitRange>[0:0]</bitRange>
              <access>read-write</access>
            </field>

            <field>
              <name>BUSY</name>
              <description>Set to 1 if accelerator is busy</description>
              <bitRange>[1:1]</bitRange>
              <access>read-only</access>
            </field>
          </fields>
        </register>

        <register>
          <name>CTRL_SET</name>
          <description>Set individual bits of the STATUS register</description>
          <addressOffset>0x0004</addressOffset>
          <resetValue>0x00000000</resetValue>
          <fields>

            <field>
              <name>ENABLE</name>
              <description>Enable the accelerator</description>
              <bitRange>[0:0]</bitRange>
              <access>read-write</access>
            </field>

            <field>
              <name>BUSY</name>
              <description>Set to 1 if accelerator is busy</description>
              <bitRange>[1:1]</bitRange>
              <access>read-only</access>
            </field>
          </fields>
        </register>

         <register>
          <name>CTRL_CLR</name>
          <description>Clear individual bits of the STATUS register</description>
          <addressOffset>0x0008</addressOffset>
          <resetValue>0x00000000</resetValue>
          <fields>

            <field>
              <name>ENABLE</name>
              <description>Disable the accelerator</description>
              <bitRange>[0:0]</bitRange>
              <access>read-write</access>
            </field>

            <field>
              <name>BUSY</name>
              <description>Set to 1 if accelerator is busy</description>
              <bitRange>[1:1]</bitRange>
              <access>read-only</access>
            </field>
          </fields>
        </register>

        <!--
        <register>
          <name>NUM_TREES</name>
          <description>Number of trees in forest</description>
          <addressOffset>0x000c</addressOffset>
          <resetValue>0x00000000</resetValue>
          <fields>
            <field>
              <name>NUM</name>
              <description>Number of trees in the forest</description>
              <bitRange>[31:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>

        <register>
          <name>NUM_FEATURES</name>
          <description>Number of features in forest</description>
          <addressOffset>0x0014</addressOffset>
          <resetValue>0x00000000</resetValue>
          <fields>
            <field>
              <name>NUM</name>
              <description>Number of features in the forest</description>
              <bitRange>[31:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        -->

        <register>
          <name>PREDICTION</name>
          <description>Predicted class</description>
          <addressOffset>0x001c</addressOffset>
          <resetValue>0x00000000</resetValue>
          <fields>
            <field>
              <name>CLASS</name>
              <description>Predicted class</description>
              <bitRange>[31:0]</bitRange>
              <access>read-only</access>
            </field>
          </fields>
        </register>

        <register>
          <name>VOTES</name>
          <description>Number of votes for the predicted class</description>
          <addressOffset>0x0020</addressOffset>
          <resetValue>0x00000000</resetValue>
          <fields>
            <field>
              <name>NUM</name>
              <description>Number of votes for the predicted class</description>
              <bitRange>[31:0]</bitRange>
              <access>read-only</access>
            </field>
          </fields>
        </register>

        <register>
          <name>INTEN_SET</name>
          <description>Set individual bits of the INTEN register</description>
          <addressOffset>0x0024</addressOffset>
          <resetValue>0x00000000</resetValue>
          <fields>

            <field>
              <name>ERROR</name>
              <description>Error interrupt</description>
              <bitRange>[1:1]</bitRange>
              <access>read-write</access>
            </field>

            <field>
              <name>READY</name>
              <description>Ready interrupt</description>
              <bitRange>[0:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>

        <register>
          <name>INTEN_CLR</name>
          <description>Clear individual bits of the INTEN register</description>
          <addressOffset>0x0028</addressOffset>
          <resetValue>0x00000000</resetValue>
          <fields>

            <field>
              <name>ERROR</name>
              <description>Error interrupt</description>
              <bitRange>[1:1]</bitRange>
              <access>read-write</access>
            </field>

            <field>
              <name>READY</name>
              <description>Ready interrupt</description>
              <bitRange>[0:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>

        <register>
          <name>INTFLAG</name>
          <description>Interrupt flags</description>
          <addressOffset>0x002c</addressOffset>
          <resetValue>0x00000000</resetValue>
          <fields>

            <field>
              <name>ERROR</name>
              <description>Error interrupt</description>
              <bitRange>[1:1]</bitRange>
              <access>read-write</access>
            </field>

            <field>
              <name>READY</name>
              <description>Ready interrupt</description>
              <bitRange>[0:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>

        <register>
          <name>PERF</name>
          <description>Performance stats</description>
          <addressOffset>0x0030</addressOffset>
          <resetValue>0x00000000</resetValue>
          <fields>

            <field>
              <name>CYCCNT</name>
              <description>Cycle count for the last prediction</description>
              <bitRange>[31:0]</bitRange>
              <access>read-only</access>
            </field>
          </fields>
        </register>

        <register>
          <name>NUM_CELLS</name>
          <description>Number of cells</description>
          <addressOffset>0x0034</addressOffset>
          <resetValue>0x00000000</resetValue>
          <fields>

            <field>
              <name>NUM_CELLS</name>
              <description>Number of cell instances in this peripheral</description>
              <bitRange>[31:0]</bitRange>
              <access>read-only</access>
            </field>
          </fields>
        </register>

        <register>
          <name>FEAT_WRITE[%s]</name>
          <description>Write features</description>
          <dim>128</dim>
          <dimIncrement>0x4</dimIncrement>
          <addressOffset>0x0040</addressOffset>
          <resetValue>0x00000000</resetValue>
         <fields>

            <field>
              <name>CHUNK0</name>
              <description>Lower 16-bit chunk of features (bits 15:0)</description>
              <bitRange>[15:0]</bitRange>
              <access>write-only</access>
            </field>

            <field>
              <name>CHUNK1</name>
              <description>Upper 16-bit chunk of features (bits 31:16)</description>
              <bitRange>[31:16]</bitRange>
              <access>write-only</access>
            </field>

          </fields>
        </register>

      </registers>
      
    </peripheral>