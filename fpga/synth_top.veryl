/// Synthesis harness for ForestTop.
///
/// A thin pass-through: every DUT port is exposed at the top level, so nothing
/// can be optimised away and there is no stimulus generator to distort the
/// results. The Wishbone bundles are flattened to plain vectors because Vivado
/// does not accept SystemVerilog interfaces on the top-level synthesis boundary;
/// they are re-bundled internally and handed to the DUT unchanged.
///
/// The boundary is false-pathed in the XDC, so the only timed paths are
/// register-to-register inside the core.
module BenchTop #(
    param CELL_INSTANCES      : u32   = 4    ,
    param USE_SUPERSCALAR     : bbool = true ,
    param READ_PORTS_PER_CACHE: u8    = 2    ,
    param CELL_CACHE_SIZE     : u64   = 16384,
    param VOTE_FIFO_DEPTH     : u32   = 4    ,

    const WB_ADDR_WIDTH: u8 = 32,
    const WB_DATA_WIDTH: u8 = 32,
    const WB_SEL_WIDTH : u8 = 4 ,
) (
    clk      : input clock           ,
    wb_rst   : input reset_async_high,
    rst_cache: input reset           ,

    // ---- Control port (flattened Wishbone slave) -------------------------
    ctrl_cyc         : input  logic                 ,
    ctrl_stb         : input  logic                 ,
    ctrl_we          : input  logic                 ,
    ctrl_lock        : input  logic                 ,
    ctrl_sel         : input  logic<WB_SEL_WIDTH>   ,
    ctrl_addr        : input  logic<WB_ADDR_WIDTH>  ,
    ctrl_write_data  : input  logic<WB_DATA_WIDTH>  ,
    ctrl_read_data   : output logic<WB_DATA_WIDTH>  ,
    ctrl_ack         : output logic                 ,

    // ---- Cell cache ports (flattened, one slice per cell) ----------------
    cache_cyc        : input  logic<CELL_INSTANCES>                 ,
    cache_stb        : input  logic<CELL_INSTANCES>                 ,
    cache_we         : input  logic<CELL_INSTANCES>                 ,
    cache_lock       : input  logic<CELL_INSTANCES>                 ,
    cache_sel        : input  logic<WB_SEL_WIDTH * CELL_INSTANCES>  ,
    cache_addr       : input  logic<WB_ADDR_WIDTH * CELL_INSTANCES> ,
    cache_write_data : input  logic<WB_DATA_WIDTH * CELL_INSTANCES> ,
    cache_read_data  : output logic<WB_DATA_WIDTH * CELL_INSTANCES> ,
    cache_ack        : output logic<CELL_INSTANCES>                 ,

    interrupt: output logic,
) {
    // ---- Re-bundle -------------------------------------------------------
    inst control_bus: memutils::Wishbone #(
        ADDR_WIDTH: WB_ADDR_WIDTH,
        DATA_WIDTH: WB_DATA_WIDTH,
    );

    inst cache_bus: memutils::Wishbone [CELL_INSTANCES] #(
        ADDR_WIDTH: WB_ADDR_WIDTH,
        DATA_WIDTH: WB_DATA_WIDTH,
    );

    assign control_bus.cyc          = ctrl_cyc;
    assign control_bus.stb          = ctrl_stb;
    assign control_bus.write_enable = ctrl_we;
    assign control_bus.lock         = ctrl_lock;
    assign control_bus.select       = ctrl_sel;
    assign control_bus.addr         = ctrl_addr;
    assign control_bus.write_data   = ctrl_write_data;

    assign ctrl_read_data = control_bus.read_data;
    assign ctrl_ack       = control_bus.ack;

    for i in 0..CELL_INSTANCES :wire_cache {
        assign cache_bus[i].cyc          = cache_cyc[i];
        assign cache_bus[i].stb          = cache_stb[i];
        assign cache_bus[i].write_enable = cache_we[i];
        assign cache_bus[i].lock         = cache_lock[i];
        assign cache_bus[i].select       = cache_sel[(i * WB_SEL_WIDTH)+:WB_SEL_WIDTH];
        assign cache_bus[i].addr         = cache_addr[(i * WB_ADDR_WIDTH)+:WB_ADDR_WIDTH];
        assign cache_bus[i].write_data   = cache_write_data[(i * WB_DATA_WIDTH)+:WB_DATA_WIDTH];

        assign cache_read_data[(i * WB_DATA_WIDTH)+:WB_DATA_WIDTH] = cache_bus[i].read_data;
        assign cache_ack[i]                                        = cache_bus[i].ack;
    }

    // ---- DUT -------------------------------------------------------------
    inst dut: ForestTop::<standard_layout> #(
        CELL_INSTANCES            ,
        USE_SUPERSCALAR           ,
        READ_PORTS_PER_CACHE      ,
        CELL_CACHE_SIZE           ,
        INHIBIT_ERR         : true,
        VOTE_FIFO_DEPTH           ,
    ) (
        clk                       ,
        wb_rst                    ,
        rst_cache                 ,
        control_port : control_bus,
        cell_cache_wb: cache_bus  ,
        interrupt                 ,
    );
}