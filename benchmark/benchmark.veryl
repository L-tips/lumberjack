module Benchmark (
    clk: input clock,
    rst: input reset,

    irq     : output logic    ,
    dbg_mark: input  logic<16>,
) {
    const CELL_CACHE_SIZE      : u64 = 4096;
    const CELL_CACHE_ADDR_WIDTH: u32 = $clog2(CELL_CACHE_SIZE);

    const CELL_INSTANCES      : u32   = 4;
    const READ_PORTS_PER_CACHE: u32   = 4;
    const USE_SUPERSCALAR     : bbool = true;
    const VOTE_FIFO_DEPTH     : u8    = 2;
    const CELL_CACHE_NUM_COL  : u8    = if USE_SUPERSCALAR ? node_layout::NODE_SIZE * 2 : node_layout::NODE_SIZE;

    let wb_rst: reset_async_high = rst as reset_async_high;

    const WB_DATA_WIDTH: u8 = 32;
    const WB_ADDR_WIDTH: u8 = 32;

    inst cell_cache_ports: memutils::Wishbone [CELL_INSTANCES] #(
        DATA_WIDTH: WB_DATA_WIDTH,
        ADDR_WIDTH: WB_ADDR_WIDTH,
    );

    inst control_bus: memutils::Wishbone #( ADDR_WIDTH: WB_ADDR_WIDTH, DATA_WIDTH: WB_DATA_WIDTH );

    inst forest_top: ForestTop::<test_layout> #(
        CELL_CACHE_SIZE           ,
        CELL_INSTANCES            ,
        USE_SUPERSCALAR           ,
        READ_PORTS_PER_CACHE      ,
        INHIBIT_ERR         : true,
        VOTE_FIFO_DEPTH           ,
    ) (
        clk                            ,
        wb_rst                         ,
        rst_cache    : rst             ,
        control_port : control_bus     ,
        cell_cache_wb: cell_cache_ports,
        interrupt    : irq             ,
    );
}
